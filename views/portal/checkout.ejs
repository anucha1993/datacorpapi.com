<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <a href="/portal/services" class="muted small">← Back to services</a>
    <h1>Review your order</h1>
  </div>
</div>

<div class="steps" aria-label="Checkout steps">
  <span class="s done"><span class="n">✓</span>Choose service</span><span class="sep"></span>
  <span class="s on"><span class="n">2</span>Review order</span><span class="sep"></span>
  <span class="s"><span class="n">3</span>Secure payment</span><span class="sep"></span>
  <span class="s"><span class="n">4</span>Receipt</span>
</div>

<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>

<form method="post" action="/portal/services/<%= svc.id %>/buy" class="layout-side">
  <div>
    <section class="card">
      <div class="section-title">Service</div>
      <h2 style="font-size:19px;margin:0 0 6px"><%= svc.name %></h2>
      <% if (svc.description) { %><p class="muted" style="margin:0;white-space:pre-line"><%= svc.description %></p><% } %>
    </section>

    <section class="card">
      <div class="card-head" style="margin-bottom:10px"><div class="section-title" style="margin:0">Billed to</div><a href="/portal/profile" class="small">Edit details</a></div>
      <% if (!profileComplete) { %><p class="notice small">Your company details are incomplete — <a href="/portal/profile">add them now</a> so the receipt shows your company name, address and tax ID.</p><% } %>
      <dl class="kv">
        <dt>Company</dt><dd><%= user.company_name || '—' %></dd>
        <dt>Tax ID</dt><dd><%= user.tax_id || '—' %></dd>
        <dt>Address</dt><dd><%= user.address ? user.address + (user.zip ? ' ' + user.zip : '') : '—' %></dd>
        <dt>Receipt email</dt><dd><%= user.billing_email || user.email || '—' %></dd>
        <dt>Account</dt><dd class="mono"><%= user.operator %></dd>
      </dl>
    </section>
  </div>

  <aside class="card summary sticky">
    <div class="section-title">Order summary</div>
    <div class="line"><span><%= svc.name %></span><span>฿<%= fmtMoney(svc.price_thb) %></span></div>
    <div class="line muted"><span>Quantity</span><span>1</span></div>
    <div class="line total"><span>Total</span><span>฿<%= fmtMoney(svc.price_thb) %></span></div>
    <p class="muted small" style="margin:4px 0 16px">One-time charge in Thai Baht. Any applicable taxes are shown at checkout.</p>
    <label class="check" style="margin-bottom:14px"><input type="checkbox" name="agree" value="1" required>
      <span>I agree to the <a href="/terms" target="_blank">Terms of Service</a> and <a href="/refund" target="_blank">Refund Policy</a>.</span></label>
    <button class="primary lg block"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Continue to secure payment</button>
    <p class="muted small" style="margin:12px 0 0;text-align:center">You'll be redirected to <%= co.PAY.name %> to pay by <%= co.PAY.paymentMethods %>. We never see your card details. An invoice is created in your account so you can return and pay later.</p>
  </aside>
</form>
<%- include('partials/footer') %>
