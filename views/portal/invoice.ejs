<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <a href="/portal/billing" class="muted small no-print">← All payments</a>
    <h1>Payment <%= inv.invoice_no %></h1>
  </div>
  <% if (inv.receipt_url) { %><div class="tools no-print">
    <a class="btn" href="<%= inv.receipt_url %>" target="_blank" rel="noopener">Official invoice / receipt (<%= co.PAY.name %>) ↗</a>
  </div><% } %>
</div>

<div class="layout-side">
  <%- include('../partials/invoice_doc') %>

  <aside class="sticky no-print mobile-first">
    <section class="card">
      <div class="section-title">Amount due</div>
      <div style="font-size:30px;font-weight:800;letter-spacing:-.02em">฿<%= fmtMoney(inv.status === 'open' ? inv.amount_thb : 0) %></div>
      <% if (inv.status === 'open') { %>
        <p class="muted small" style="margin:4px 0 16px">Due <%= inv.due_at || 'on receipt' %><% if (overdue) { %> · <span class="badge b-overdue">Overdue</span><% } %></p>
        <% if (inv.checkout_url) { %>
          <a href="<%= inv.checkout_url %>" class="btn primary lg block"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Pay ฿<%= fmtMoney(inv.amount_thb) %> securely</a>
          <div class="trust" style="margin-top:12px;justify-content:center">
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Encrypted checkout</span>
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Powered by <%= co.PAY.name %></span>
          </div>
        <% } else { %>
          <p class="notice small">The online payment link is being prepared. Please check back shortly or contact <%= co.COMPANY_EMAIL || 'support' %>.</p>
        <% } %>
      <% } else if (inv.status === 'paid') { %>
        <p style="margin:6px 0 0"><span class="badge b-paid">Paid in full</span> <span class="muted small"><%= String(inv.paid_at || '').slice(0, 10) %></span></p>
      <% } else { %>
        <p style="margin:6px 0 0"><span class="badge b-<%= inv.status %>"><%= STATUS_INV[inv.status] %></span></p>
      <% } %>
    </section>

    <section class="card">
      <div class="section-title">Receipts &amp; documents</div>
      <% if (!inv.receipt_url && !files.length) { %>
        <p class="muted small" style="margin:0"><%= inv.status === 'paid' ? co.PAY.name + ' is generating your official invoice/receipt — it appears here within a few minutes.' : 'After payment, ' + co.PAY.name + ' issues the official invoice/receipt — it appears here.' %></p>
      <% } else { %>
        <ul class="filelist">
          <% if (inv.receipt_url) { %><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><span class="fname">Official invoice / receipt (<%= co.PAY.name %>)</span><a href="<%= inv.receipt_url %>" target="_blank" rel="noopener" class="btn small">Open</a></li><% } %>
          <% for (const f of files) { %><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><span class="fname" title="<%= f.filename %>"><%= f.kind === 'tax_invoice' ? 'Tax invoice' : f.kind === 'receipt' ? 'Receipt' : 'Document' %> · <%= f.filename %></span><a href="/portal/attachments/<%= f.id %>" target="_blank" class="btn small">Download</a></li><% } %>
        </ul>
      <% } %>
    </section>

    <p class="muted small">Need a correction (company name, tax ID)? Update your <a href="/portal/profile">company details</a> before paying, or contact <%= co.COMPANY_EMAIL || 'support' %>.</p>
  </aside>
</div>
<%- include('partials/footer') %>
