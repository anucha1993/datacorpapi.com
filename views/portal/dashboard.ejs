<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <h1>Welcome<%= user.company_name || user.display_name ? ', ' + (user.company_name || user.display_name) : '' %></h1>
    <p class="subtitle">Usage for <b><%= ym %></b> · serial <code style="font-weight:600"><%= user.serial_no || '—' %></code></p>
  </div>
  <div class="tools">
    <form method="get" class="monthpick" action="/portal">
      <label>Month
        <select name="ym" onchange="this.form.submit()"><% for (const m of months) { %><option value="<%= m %>" <%= m === ym ? 'selected' : '' %>><%= m %></option><% } %></select>
      </label>
    </form>
    <a class="btn" href="/portal/export.csv?ym=<%= ym %>">Export CSV</a>
  </div>
</div>

<% if (user.must_change) { %><p class="notice">Please <a href="/portal/password">change the temporary password</a> you were given.</p><% } %>

<% const owed = openInvoices.reduce((s, i) => s + Number(i.amount_thb || 0), 0); %>
<% if (openInvoices.length) { %>
<section class="balance">
  <div>
    <div class="k">Outstanding balance</div>
    <div class="v">฿<%= fmtMoney(owed) %> <small><%= openInvoices.length %> unpaid invoice<%= openInvoices.length === 1 ? '' : 's' %></small></div>
    <div class="meta">Earliest due <%= openInvoices.map(i => i.due_at).filter(Boolean).sort()[0] || '—' %></div>
  </div>
  <a class="btn lg" href="<%= openInvoices.length === 1 ? '/portal/invoices/' + encodeURIComponent(openInvoices[0].invoice_no) : '/portal/billing' %>">Review &amp; pay</a>
</section>
<% } %>

<section class="tiles">
  <div class="tile"><div class="k">Estimated charge this month</div><div class="v"><%= fmtMoney(totals.amount) %> <small>THB</small></div></div>
  <div class="tile"><div class="k">Billable records</div><div class="v"><%= fmtNum(totals.records) %></div></div>
  <div class="tile"><div class="k">Runs</div><div class="v"><%= fmtNum(totals.runs) %> <small class="muted">ok <%= fmtNum(totals.ok) %> · cancelled <%= fmtNum(totals.cancelled) %> · error <%= fmtNum(totals.error) %></small></div></div>
  <div class="tile"><div class="k">Time the software worked for you</div><div class="v"><%= fmtDur(totals.total_sec) %></div></div>
</section>

<div class="grid2">
  <section class="card">
    <h2>By task type</h2>
    <% if (!byMode.length) { %><p class="muted">No usage this month</p><% } else { %>
    <table>
      <thead><tr><th>Task type</th><th class="r">Runs</th><th class="r">Records</th><th class="r">Price / record</th><th class="r">Amount (THB)</th></tr></thead>
      <tbody>
      <% for (const r of byMode) { %>
        <tr>
          <td><%= r.mode_label %> <span class="tag g-<%= r.mode_group %>"><%= GROUP_LABELS[r.mode_group] || '' %></span></td>
          <td class="r"><%= fmtNum(r.runs) %></td>
          <td class="r"><%= fmtNum(r.billable_records) %></td>
          <td class="r muted"><%= r.price_per_record != null ? fmtMoney(r.price_per_record) : '—' %><% if (Number(r.custom_price)) { %> <small>(your rate)</small><% } %></td>
          <td class="r strong"><%= fmtMoney(r.amount_thb) %></td>
        </tr>
      <% } %>
      </tbody>
      <tfoot><tr><th colspan="4">Total</th><th class="r"><%= fmtMoney(totals.amount) %></th></tr></tfoot>
    </table>
    <p class="muted small">Estimate based on current unit prices. The final amount is on the invoice issued on the 1st of next month. Cancelled or failed jobs are billed only for the records completed.</p>
    <% } %>
  </section>

  <section class="card">
    <h2>Last 12 months</h2>
    <% if (!trend.length) { %><p class="muted">No data yet</p><% } else { %>
    <table>
      <thead><tr><th>Month</th><th class="r">Runs</th><th class="r">Records</th><th class="r">Amount (THB)</th><th>Invoiced</th></tr></thead>
      <tbody>
      <% for (const t of trend) { const rep = reports[t.ym]; %>
        <tr class="<%= t.ym === ym ? 'hl' : '' %>">
          <td><a href="/portal?ym=<%= t.ym %>"><%= t.ym %></a></td>
          <td class="r"><%= fmtNum(t.runs) %></td>
          <td class="r"><%= fmtNum(t.billable_records) %></td>
          <td class="r strong"><%= fmtMoney(t.amount_thb) %></td>
          <td><% if (rep) { %><span class="st st-<%= rep.ok ? 'ok' : 'cancelled' %>" title="Sent <%= rep.sent_at %>">Billed <%= fmtMoney(rep.amount_thb) %></span><% } else { %><span class="muted">—</span><% } %></td>
        </tr>
      <% } %>
      </tbody>
    </table>
    <% } %>

    <h2 style="margin-top:18px">Unpaid invoices</h2>
    <% if (!openInvoices.length) { %><p class="muted">Nothing outstanding — you're all paid up.</p><% } else { for (const i of openInvoices) { %>
      <p><a class="linkish mono" href="/portal/invoices/<%= encodeURIComponent(i.invoice_no) %>"><%= i.invoice_no %></a> · <b>฿<%= fmtMoney(i.amount_thb) %></b> · <span class="muted">due <%= i.due_at || '—' %></span></p>
    <% } } %>
  </section>
</div>

<section class="card">
  <h2>Recent jobs this month <span class="muted">(<%= runs.length %><%= runs.length >= 200 ? ' shown' : '' %>)</span></h2>
  <% if (!runs.length) { %><p class="muted">No jobs</p><% } else { %>
  <div class="scroll"><table class="dense">
    <thead><tr><th>Started</th><th>Task type</th><th>e-WP account</th><th class="r">Records</th><th class="r">Duration</th><th>Status</th><th>Machine</th></tr></thead>
    <tbody>
    <% for (const r of runs) { %>
      <tr>
        <td class="nowrap"><%= r.started_at %></td>
        <td><%= MODE_LABELS[r.mode] || r.mode %></td>
        <td class="muted"><%= r.ewp_username %></td>
        <td class="r"><%= fmtNum(r.status === 'ok' ? r.record_count : Math.max(r.record_count, r.progress_done)) %></td>
        <td class="r muted"><%= fmtDur(r.duration_sec) %></td>
        <td><span class="st st-<%= r.status %>"><%= STATUS_LABELS[r.status] || r.status %></span></td>
        <td class="muted nowrap"><%= r.machine %></td>
      </tr>
    <% } %>
    </tbody>
  </table></div>
  <% } %>
</section>
<%- include('partials/footer') %>
