<%- include('partials/header') %>
<div class="pagehead">
  <h1>ยอดการใช้งานเดือน <%= ym %></h1>
  <div class="tools">
    <form method="get" class="monthpick" action="/portal">
      <label>เดือน
        <select name="ym" onchange="this.form.submit()"><% for (const m of months) { %><option value="<%= m %>" <%= m === ym ? 'selected' : '' %>><%= m %></option><% } %></select>
      </label>
    </form>
    <a class="btn" href="/portal/export.csv?ym=<%= ym %>">⬇ CSV</a>
    <a class="btn" href="/portal/billing">การชำระเงิน</a>
  </div>
</div>

<% if (user.must_change) { %><p class="alert">กรุณา<a href="/portal/password">เปลี่ยนรหัสผ่าน</a>ที่ได้รับมาครั้งแรกก่อนใช้งานต่อ</p><% } %>

<section class="tiles">
  <div class="tile"><div class="k">ค่าบริการประมาณการเดือนนี้</div><div class="v"><%= fmtMoney(totals.amount) %> <small>บาท</small></div></div>
  <div class="tile"><div class="k">รายการที่คิดเงิน</div><div class="v"><%= fmtNum(totals.records) %></div></div>
  <div class="tile"><div class="k">จำนวนครั้งที่รัน</div><div class="v"><%= fmtNum(totals.runs) %> <small class="muted">สำเร็จ <%= fmtNum(totals.ok) %> · ยกเลิก <%= fmtNum(totals.cancelled) %> · ผิดพลาด <%= fmtNum(totals.error) %></small></div></div>
  <div class="tile"><div class="k">เวลาที่โปรแกรมทำงานแทนคุณ</div><div class="v"><%= fmtDur(totals.total_sec) %></div></div>
</section>

<div class="grid2">
  <section class="card">
    <h2>แยกตามประเภทงาน</h2>
    <% if (!byMode.length) { %><p class="muted">ยังไม่มีการใช้งานในเดือนนี้</p><% } else { %>
    <table>
      <thead><tr><th>ประเภทงาน</th><th class="r">ครั้ง</th><th class="r">รายการ</th><th class="r">ราคา/รายการ</th><th class="r">ค่าบริการ (บาท)</th></tr></thead>
      <tbody>
      <% for (const r of byMode) { %>
        <tr>
          <td><%= r.mode_label %> <span class="tag g-<%= r.mode_group %>"><%= GROUP_LABELS[r.mode_group] || '' %></span></td>
          <td class="r"><%= fmtNum(r.runs) %></td>
          <td class="r"><%= fmtNum(r.billable_records) %></td>
          <td class="r muted"><%= r.price_per_record != null ? fmtMoney(r.price_per_record) : '—' %></td>
          <td class="r strong"><%= fmtMoney(r.amount_thb) %></td>
        </tr>
      <% } %>
      </tbody>
      <tfoot><tr><th colspan="4">รวม</th><th class="r"><%= fmtMoney(totals.amount) %></th></tr></tfoot>
    </table>
    <p class="muted small">ยอดนี้เป็นประมาณการจากราคาต่อรายการปัจจุบัน ยอดเรียกเก็บจริงดูจากใบแจ้งหนี้/ใบเสร็จของ Lemon Squeezy ที่ส่งทางอีเมลสิ้นเดือน · งานที่ยกเลิกหรือผิดพลาดคิดเฉพาะส่วนที่ทำสำเร็จแล้ว</p>
    <% } %>
  </section>

  <section class="card">
    <h2>ย้อนหลัง 12 เดือน</h2>
    <% if (!trend.length) { %><p class="muted">ยังไม่มีข้อมูล</p><% } else { %>
    <table>
      <thead><tr><th>เดือน</th><th class="r">ครั้ง</th><th class="r">รายการ</th><th class="r">ค่าบริการ (บาท)</th><th>เรียกเก็บแล้ว</th></tr></thead>
      <tbody>
      <% for (const t of trend) { const rep = reports[t.ym]; %>
        <tr class="<%= t.ym === ym ? 'hl' : '' %>">
          <td><a href="/portal?ym=<%= t.ym %>"><%= t.ym %></a></td>
          <td class="r"><%= fmtNum(t.runs) %></td>
          <td class="r"><%= fmtNum(t.billable_records) %></td>
          <td class="r strong"><%= fmtMoney(t.amount_thb) %></td>
          <td><% if (rep) { %><span class="st st-<%= rep.ok ? 'ok' : 'cancelled' %>" title="ส่งเมื่อ <%= rep.sent_at %>">ส่งเรียกเก็บ <%= fmtMoney(rep.amount_thb) %></span><% } else { %><span class="muted">—</span><% } %></td>
        </tr>
      <% } %>
      </tbody>
    </table>
    <% } %>

    <h2 style="margin-top:18px">ใบแจ้งหนี้ค้างชำระ</h2>
    <% if (!openInvoices.length) { %><p class="muted">ไม่มียอดค้างชำระ</p><% } else { for (const i of openInvoices) { %>
      <p><b><%= i.invoice_no %></b> เดือน <%= i.ym %> · <b><%= fmtMoney(i.amount_thb) %></b> บาท · ครบกำหนด <%= i.due_at || '-' %> → <a href="/portal/billing">ชำระเงิน</a></p>
    <% } } %>
  </section>
</div>

<section class="card">
  <h2>งานล่าสุดในเดือนนี้ <span class="muted">(<%= runs.length %> รายการ<%= runs.length >= 200 ? ' แรก' : '' %>)</span></h2>
  <% if (!runs.length) { %><p class="muted">ไม่มีรายการ</p><% } else { %>
  <div class="scroll"><table class="dense">
    <thead><tr><th>เริ่ม</th><th>ประเภทงาน</th><th>บัญชี e-WP</th><th class="r">รายการ</th><th class="r">เวลา</th><th>สถานะ</th><th>เครื่อง</th></tr></thead>
    <tbody>
    <% for (const r of runs) { %>
      <tr>
        <td class="nowrap"><%= r.started_at %></td>
        <td><%= MODE_LABELS[r.mode] || r.mode %></td>
        <td class="muted"><%= r.ewp_username %></td>
        <td class="r"><%= fmtNum(r.status === 'ok' ? r.record_count : Math.max(r.record_count, r.progress_done)) %></td>
        <td class="r muted"><%= fmtDur(r.duration_sec) %></td>
        <td><span class="st st-<%= r.status %>"><%= STATUS_LABELS[r.status] || r.status %></span></td>
        <td class="muted nowrap"><%= r.machine %></td>
      </tr>
    <% } %>
    </tbody>
  </table></div>
  <% } %>
</section>
<%- include('partials/footer') %>
