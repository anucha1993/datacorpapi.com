<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <h1>Welcome<%= user.company_name || user.display_name ? ', ' + (user.company_name || user.display_name) : '' %></h1>
    <p class="subtitle">Your plans and this month's usage. Quotas reset on the 1st of every month.</p>
  </div>
  <div class="tools"><a class="btn primary" href="/portal/plans">Browse plans</a></div>
</div>

<% if (user.must_change) { %><p class="notice">Please <a href="/portal/password">change the temporary password</a> you were given.</p><% } %>

<% const owed = openInvoices.reduce((s, i) => s + Number(i.amount_thb || 0), 0); %>
<% if (openInvoices.length) { %>
<section class="balance">
  <div>
    <div class="k">Outstanding balance</div>
    <div class="v">฿<%= fmtMoney(owed) %> <small><%= openInvoices.length %> unpaid invoice<%= openInvoices.length === 1 ? '' : 's' %></small></div>
    <div class="meta">Earliest due <%= openInvoices.map(i => i.due_at).filter(Boolean).sort()[0] || '—' %></div>
  </div>
  <a class="btn lg" href="<%= openInvoices.length === 1 ? '/portal/invoices/' + encodeURIComponent(openInvoices[0].invoice_no) : '/portal/billing' %>">Review &amp; pay</a>
</section>
<% } %>

<% const pastDue = subs.filter(s => s.status === 'past_due'); %>
<% if (pastDue.length) { %><p class="alert">Payment for <b><%= pastDue.map(s => s.product_name).join(', ') %></b> failed — your keys are paused. <a href="/portal/payment-methods">Update your payment method</a> to restore access.</p><% } %>

<% if (!subs.length) { %>
<section class="card"><div class="empty">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
  <h3>You don't have a plan yet</h3>
  <p>Pick a plan to get your API key or license key — free plans activate instantly.</p>
  <a class="btn primary" href="/portal/plans">See plans</a>
</div></section>
<% } else { %>
<section class="sub-grid">
  <% for (const s of subs) { const over = s.included != null && s.used > s.included; %>
  <a class="sub-card" href="/portal/subscriptions/<%= s.id %>">
    <div class="sub-top">
      <div>
        <div class="sub-product"><%= s.product_name %></div>
        <div class="sub-plan"><%= s.plan_name %> <span class="muted">· <%= BILLING_LABELS[s.billing] %></span></div>
      </div>
      <span class="badge b-<%= s.status %>"><%= SUB_STATUS[s.status] %></span>
    </div>
    <div class="sub-usage">
      <div class="btnrow" style="justify-content:space-between">
        <span class="muted small"><%= s.unit_label %> this month</span>
        <span class="small"><b><%= fmtNum(s.used) %></b><span class="muted"> / <%= s.included == null ? 'unlimited' : fmtNum(s.included) %></span></span>
      </div>
      <% if (s.included) { %><div class="meter <%= s.pct >= 100 ? 'over' : s.pct >= 80 ? 'warn' : '' %>"><span style="width:<%= s.pct %>%"></span></div><% } %>
      <% if (over && Number(s.unit_price_thb)) { %><div class="small" style="color:var(--warn)"><%= fmtNum(s.used - s.included) %> over quota · ฿<%= fmtMoney((s.used - s.included) * Number(s.unit_price_thb)) %> billed next month</div>
      <% } else if (s.included != null && s.pct >= 100) { %><div class="small" style="color:var(--danger)">Quota reached — requests are blocked until the 1st. <u>Upgrade</u></div><% } %>
    </div>
    <div class="sub-foot">
      <span><%= s.kind === 'license' ? 'License keys' : 'API keys' %>: <b><%= s.key_count %></b> / <%= s.max_keys %></span>
      <span><% if (s.status === 'pending') { %>Awaiting payment<% } else if (s.cancel_at_period_end) { %>Ends <%= fmtDate(s.period_end) %><% } else if (s.period_end) { %>Renews <%= fmtDate(s.period_end) %><% } else { %>No end date<% } %></span>
    </div>
  </a>
  <% } %>
</section>
<% } %>

<section class="card" style="margin-top:18px">
  <div class="card-head"><h2>Quick start</h2><a class="small" href="/portal/plans">Plans &amp; keys →</a></div>
  <div class="steps-grid">
    <div><span class="n">1</span><b>Choose a plan</b><p class="muted small">Free plans start instantly; paid plans check out securely with <%= co.PAY.name %>.</p></div>
    <div><span class="n">2</span><b>Create a key</b><p class="muted small">Open the plan and create an API key or license key. API keys are shown once — store them safely.</p></div>
    <div><span class="n">3</span><b>Use it</b><p class="muted small">Send the key with your requests or enter the license in the app. Watch usage here in real time.</p></div>
  </div>
</section>
<%- include('partials/footer') %>
