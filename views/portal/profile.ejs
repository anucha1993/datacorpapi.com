<%- include('partials/header') %>
<div class="pagehead"><h1>ข้อมูลสำหรับออกใบเสร็จ</h1></div>
<form method="post" action="/portal/profile" class="card" style="max-width:640px">
  <% if (saved) { %><p class="ok">บันทึกแล้ว ข้อมูลนี้จะถูกเติมในหน้าชำระเงินและใบเสร็จอัตโนมัติ</p><% } %>
  <% if (error) { %><p class="alert"><%= error %></p><% } %>
  <p class="muted">กรอกครั้งเดียว ทุกครั้งที่ชำระบิล ระบบจะเติมข้อมูลนี้ให้ในหน้าชำระเงินของ Lemon Squeezy เพื่อให้ใบเสร็จออกในชื่อบริษัท/ที่อยู่ของคุณ</p>
  <div class="stack">
    <label>ชื่อผู้ใช้งาน (เปลี่ยนไม่ได้) <input value="<%= user.operator %>" disabled></label>
    <label>ชื่อบริษัท / ชื่อผู้ซื้อ (ตามที่ต้องการให้ขึ้นในใบเสร็จ) <input name="company_name" value="<%= user.company_name || '' %>" maxlength="190" required></label>
    <label>เลขประจำตัวผู้เสียภาษี (13 หลัก) <input name="tax_id" value="<%= user.tax_id || '' %>" maxlength="32" pattern="[0-9\-]{10,20}" placeholder="0105500000000"></label>
    <label>ที่อยู่ <textarea name="address" rows="3" maxlength="500" required><%= user.address || '' %></textarea></label>
    <label>รหัสไปรษณีย์ <input name="zip" value="<%= user.zip || '' %>" maxlength="16" pattern="[0-9]{5}" placeholder="10110" required></label>
    <label>อีเมลสำหรับรับใบเสร็จ <input name="billing_email" type="email" value="<%= user.billing_email || user.email || '' %>" maxlength="190" required></label>
    <label>ชื่อที่แสดงในระบบ <input name="display_name" value="<%= user.display_name || '' %>" maxlength="190"></label>
    <button class="primary">บันทึก</button>
  </div>
</form>
<%- include('partials/footer') %>
