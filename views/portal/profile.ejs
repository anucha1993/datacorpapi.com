<%- include('partials/header') %>
<div class="pagehead"><h1>Billing details</h1></div>
<form method="post" action="/portal/profile" class="card" style="max-width:640px">
  <% if (saved) { %><p class="ok">Saved. These details will be pre-filled at checkout and shown on your receipts.</p><% } %>
  <% if (error) { %><p class="alert"><%= error %></p><% } %>
  <p class="muted">Enter these once. Every time you pay an invoice, the <%= co.PAY.name %> checkout is pre-filled with this information so the receipt is issued to your company name and address.</p>
  <div class="stack">
    <label>Operator name (cannot be changed) <input value="<%= user.operator %>" disabled></label>
    <label>Serial number — enter this in the desktop app (Settings → Serial number)
      <span style="display:flex;gap:8px"><input value="<%= user.serial_no || '' %>" readonly style="font-family:Consolas,monospace;font-weight:600"><button type="button" class="btn" onclick="navigator.clipboard.writeText('<%= user.serial_no || '' %>');this.textContent='Copied'">Copy</button></span>
    </label>
    <label>Company / buyer name (as it should appear on receipts) <input name="company_name" value="<%= user.company_name || '' %>" maxlength="190" required></label>
    <label>Tax ID (13 digits) <input name="tax_id" value="<%= user.tax_id || '' %>" maxlength="32" pattern="[0-9\-]{10,20}" placeholder="0105500000000"></label>
    <label>Address <textarea name="address" rows="3" maxlength="500" required><%= user.address || '' %></textarea></label>
    <label>Postal code <input name="zip" value="<%= user.zip || '' %>" maxlength="16" pattern="[0-9]{5}" placeholder="10110" required></label>
    <label>Email for receipts <input name="billing_email" type="email" value="<%= user.billing_email || user.email || '' %>" maxlength="190" required></label>
    <label>Display name in the portal <input name="display_name" value="<%= user.display_name || '' %>" maxlength="190"></label>
    <button class="primary">Save</button>
  </div>
</form>
<%- include('partials/footer') %>
