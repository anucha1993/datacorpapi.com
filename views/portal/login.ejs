<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Customer login · <%= co.PRODUCT_NAME %></title>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/style.css">
</head>
<body class="center">
<form method="post" action="/portal/login" class="card login">
  <h1><%= co.PRODUCT_NAME %></h1>
  <p class="muted">Customer login — view your usage, invoices and payments</p>
  <% if (error) { %><p class="alert"><%= error %></p><% } %>
  <input type="text" name="operator" placeholder="Operator name (as used in the app)" value="<%= operator || '' %>" autofocus required autocomplete="username">
  <input type="password" name="password" placeholder="Password" required autocomplete="current-password">
  <button class="primary">Sign in</button>
  <p class="muted small">No account yet, or forgot your password? Contact <% if (co.COMPANY_EMAIL) { %><a href="mailto:<%= co.COMPANY_EMAIL %>"><%= co.COMPANY_EMAIL %></a><% } else { %>us<% } %></p>
  <p class="muted small"><a href="/">← Back to website</a></p>
</form>
</body>
</html>
