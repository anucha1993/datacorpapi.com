<% if (typeof user !== 'undefined' && user) { %>
<%- include('partials/header') %>
<section class="card"><div class="empty">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
  <h3><%= title %></h3>
  <p><%= message %></p>
  <div class="btnrow" style="justify-content:center"><a class="btn" href="/portal">Back to overview</a><a class="btn" href="/portal/billing">Invoices</a></div>
</div></section>
<%- include('partials/footer') %>
<% } else { %>
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= co.PRODUCT_NAME %></title><meta name="robots" content="noindex"><link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/style.css"></head>
<body class="center"><section class="card login" style="text-align:center">
  <h1><%= title %></h1><p class="muted"><%= message %></p>
  <a class="btn primary" href="/portal/login">Go to sign in</a>
</section></body></html>
<% } %>
