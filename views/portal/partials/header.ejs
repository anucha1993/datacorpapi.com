<% const _page = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : title; %>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= _page %> · <%= co.PRODUCT_NAME %> customer portal</title>
<meta name="robots" content="noindex">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="shell portal">
  <aside class="sidebar">
    <div class="sidebar-brand"><a href="/portal"><img class="brand-logo" src="/logo-mark.png" alt="" width="32" height="32"><span><%= co.PRODUCT_NAME %></span></a></div>
    <nav class="sidebar-nav" aria-label="Portal">
      <a href="/portal" class="<%= title === 'Overview' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg><span class="lbl">Overview</span></a>
      <a href="/portal/plans" class="<%= title === 'Plans' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg><span class="lbl">Plans &amp; keys</span></a>
      <a href="/portal/billing" class="<%= title === 'Billing' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span class="lbl">Invoices &amp; payments</span></a>
      <a href="/portal/services" class="<%= title === 'Services' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><span class="lbl">One-time services</span></a>
      <a href="/portal/profile" class="<%= title === 'Billing details' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><line x1="9" y1="9" x2="9" y2="9.01"/><line x1="9" y1="13" x2="9" y2="13.01"/><line x1="9" y1="17" x2="9" y2="17.01"/></svg><span class="lbl">Company details</span></a>
      <a href="/portal/password" class="<%= title === 'Change password' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span class="lbl">Security</span></a>
    </nav>
    <div class="sidebar-foot">
      <% if (co.COMPANY_EMAIL) { %><a href="mailto:<%= co.COMPANY_EMAIL %>" title="Contact support"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span class="lbl">Support</span></a><% } %>
      <form method="post" action="/portal/logout" class="inline"><button class="link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg><span class="lbl">Sign out</span></button></form>
    </div>
  </aside>
  <div class="main-area">
    <header class="topbar">
      <div class="topbar-crumb">Customer portal / <b><%= _page %></b></div>
      <div class="topbar-right topbar-user">
        <span class="topbar-username"><%= user.company_name || user.display_name || user.operator %></span>
        <span class="avatar" title="<%= user.operator %>"><%= (user.company_name || user.display_name || user.operator || 'U').charAt(0).toUpperCase() %></span>
      </div>
    </header>
    <main>
