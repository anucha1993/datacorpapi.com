<%- include('partials/header') %>
<div class="pagehead"><h1>Change password</h1></div>
<form method="post" action="/portal/password" class="card login" style="width:420px">
  <% if (error) { %><p class="alert"><%= error %></p><% } %>
  <% if (saved) { %><p class="ok">Password changed.</p><% } %>
  <input type="password" name="current" placeholder="Current password" required autocomplete="current-password">
  <input type="password" name="next" placeholder="New password (at least 6 characters)" required minlength="6" autocomplete="new-password">
  <input type="password" name="confirm" placeholder="Confirm new password" required minlength="6" autocomplete="new-password">
  <button class="primary">Save</button>
</form>
<%- include('partials/footer') %>
