<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <h1>Security</h1>
    <p class="subtitle">Change the password you use to sign in to the portal.</p>
  </div>
</div>
<% if (user.must_change && !saved) { %><p class="notice">For your security, please replace the temporary password you were given.</p><% } %>
<form method="post" action="/portal/password" class="card" style="max-width:520px">
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <% if (saved) { %><p class="ok" role="status">Your password has been changed.</p><% } %>
  <div class="stack">
    <label>Current password <input type="password" name="current" required autocomplete="current-password"></label>
    <label>New password <span class="hint">At least 6 characters</span><input type="password" name="next" required minlength="6" autocomplete="new-password"></label>
    <label>Confirm new password <input type="password" name="confirm" required minlength="6" autocomplete="new-password"></label>
  </div>
  <hr class="divider">
  <button class="primary">Update password</button>
</form>
<%- include('partials/footer') %>
