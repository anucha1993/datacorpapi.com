<%- include('partials/header') %>
<div class="pagehead"><h1>เปลี่ยนรหัสผ่าน</h1></div>
<form method="post" action="/portal/password" class="card login" style="width:420px">
  <% if (error) { %><p class="alert"><%= error %></p><% } %>
  <% if (saved) { %><p class="ok">เปลี่ยนรหัสผ่านแล้ว</p><% } %>
  <input type="password" name="current" placeholder="รหัสผ่านปัจจุบัน" required autocomplete="current-password">
  <input type="password" name="next" placeholder="รหัสผ่านใหม่ (อย่างน้อย 6 ตัว)" required minlength="6" autocomplete="new-password">
  <input type="password" name="confirm" placeholder="ยืนยันรหัสผ่านใหม่" required minlength="6" autocomplete="new-password">
  <button class="primary">บันทึก</button>
</form>
<%- include('partials/footer') %>
