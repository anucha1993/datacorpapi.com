<%- include('partials/header') %>
<div class="pagehead">
  <h1><a href="/admin?ym=<%= ym %>" class="back">‹</a> <%= name || '(none)' %> <span class="muted">· <%= ym %></span></h1>
  <div class="tools">
    <%- include('partials/monthpicker', { action: '/admin/operator/' + encodeURIComponent(name) }) %>
    <a class="btn" href="/admin/runs?ym=<%= ym %>&operator=<%= encodeURIComponent(name) %>">All runs</a>
    <a class="btn" href="/admin/customers/<%= encodeURIComponent(name) %>/prices">Customer prices</a>
  </div>
</div>

<div class="grid2">
  <section class="card">
    <h2>By mode</h2>
    <% if (!byMode.length) { %><p class="muted">No usage this month</p><% } else { %>
    <table>
      <thead><tr><th>Mode</th><th class="r">Runs</th><th class="r">Records</th><th class="r">Time</th><th class="r">Amount (THB)</th></tr></thead>
      <tbody>
      <% let sum = 0; for (const r of byMode) { sum += Number(r.amount_thb || 0); %>
        <tr>
          <td><%= r.mode_label %> <span class="tag g-<%= r.mode_group %>"><%= GROUP_LABELS[r.mode_group] || '' %></span><% if (Number(r.custom_price)) { %> <span class="tag">custom ฿<%= fmtMoney(r.unit_price) %></span><% } %></td>
          <td class="r"><%= fmtNum(r.runs) %><% if (Number(r.runs_error) || Number(r.runs_cancelled)) { %> <small class="muted">(cancelled <%= r.runs_cancelled %>, error <%= r.runs_error %>)</small><% } %></td>
          <td class="r"><%= fmtNum(r.billable_records) %></td>
          <td class="r muted"><%= fmtDur(r.total_sec) %></td>
          <td class="r strong"><%= fmtMoney(r.amount_thb) %></td>
        </tr>
      <% } %>
      </tbody>
      <tfoot><tr><th colspan="4">Total</th><th class="r"><%= fmtMoney(sum) %></th></tr></tfoot>
    </table>
    <% } %>
  </section>

  <section class="card">
    <h2>Last 12 months</h2>
    <table>
      <thead><tr><th>Month</th><th class="r">Runs</th><th class="r">Records</th><th class="r">Amount (THB)</th></tr></thead>
      <tbody>
      <% for (const t of trend) { %>
        <tr class="<%= t.ym === ym ? 'hl' : '' %>">
          <td><a href="/admin/operator/<%= encodeURIComponent(name) %>?ym=<%= t.ym %>"><%= t.ym %></a></td>
          <td class="r"><%= fmtNum(t.runs) %></td>
          <td class="r"><%= fmtNum(t.billable_records) %></td>
          <td class="r strong"><%= fmtMoney(t.amount_thb) %></td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </section>
</div>

<section class="card">
  <h2>License &amp; devices</h2>
  <% if (!acct) { %><p class="muted">No portal account for this operator — <a href="/admin/portal-users">create one</a> to issue a serial number.</p><% } else { %>
  <p>Serial: <code><%= acct.serial_no || '—' %></code> · <span class="st st-<%= acct.is_active ? 'ok' : 'error' %>"><%= acct.is_active ? 'Active' : 'Disabled' %></span></p>
  <% if (!devices.length) { %><p class="muted">No device has verified this serial yet.</p><% } else { %>
  <table class="dense"><thead><tr><th>Machine</th><th>Windows user</th><th>App</th><th>IP</th><th>First seen</th><th>Last seen</th><th class="r">Checks</th></tr></thead><tbody>
  <% for (const d of devices) { %><tr><td><%= d.machine %></td><td><%= d.windows_user %></td><td><%= d.app_version %></td><td class="muted"><%= d.ip %></td><td class="muted nowrap"><%= d.first_seen %></td><td class="nowrap"><%= d.last_seen %></td><td class="r"><%= d.verify_count %></td></tr><% } %>
  </tbody></table>
  <% } } %>
</section>

<section class="card">
  <h2>Recent runs this month <span class="muted">(<%= runs.length %><%= runs.length >= 200 ? ' shown' : '' %>)</span></h2>
  <%- include('partials/runstable', { rows: runs, showOperator: false }) %>
</section>
<%- include('partials/footer') %>
