<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <h1>Overview</h1>
    <p class="subtitle"><%= ym %> · <%= pay.name %><%= pay.testMode ? ' (test mode)' : '' %></p>
  </div>
  <div class="tools"><a class="btn" href="/admin/subscriptions">Subscriptions</a><a class="btn primary" href="/admin/products/new">+ New product</a></div>
</div>
<% if (coMissing && coMissing.length) { %><p class="notice">Business details missing in <code>.env</code> (required by the payment provider): <%= coMissing.join(', ') %></p><% } %>
<% if (!pay.ready || !pay.webhookReady) { %><p class="alert"><% if (!pay.ready) { %><code><%= pay.envApi %></code> is not set — paid plans cannot be checked out. <% } %><% if (!pay.webhookReady) { %><code><%= pay.envSecret %></code> is not set — subscriptions will not activate.<% } %></p><% } %>

<section class="tiles">
  <div class="tile"><div class="k">Monthly recurring revenue</div><div class="v">฿<%= fmtMoney(mrr) %></div><div class="muted small">monthly + yearly ÷ 12, active paid plans</div></div>
  <div class="tile"><div class="k">Active subscriptions</div><div class="v"><%= fmtNum(counts.active) %> <small><%= fmtNum(counts.customers) %> customers</small></div><div class="muted small">+<%= fmtNum(counts.new_this_month) %> this month<%= Number(counts.past_due) ? ' · ' + counts.past_due + ' payment failed' : '' %></div></div>
  <div class="tile"><div class="k">Collected this month</div><div class="v">฿<%= fmtMoney(revenue.s) %></div><div class="muted small"><%= fmtNum(revenue.n) %> paid invoices</div></div>
  <div class="tile"><div class="k">Outstanding</div><div class="v">฿<%= fmtMoney(outstanding.s) %></div><div class="muted small"><%= fmtNum(outstanding.n) %> unpaid<%= Number(outstanding.overdue) ? ' · ' + outstanding.overdue + ' overdue' : '' %> · <a href="/admin/invoices?ym=all&status=open">view</a></div></div>
</section>

<div class="grid2">
  <section class="card flush">
    <div class="card-head"><h2>Products</h2><a class="small" href="/admin/products">Manage →</a></div>
    <% if (!perProduct.length) { %><div class="empty"><h3>No products yet</h3><p>Create a product (API or license), add its plans, and it appears in the customer portal and on /pricing.</p><a class="btn primary" href="/admin/products/new">Create product</a></div><% } else { %>
    <table>
      <thead><tr><th>Product</th><th>Type</th><th class="r">Active subs</th><th class="r">Usage <%= ym %></th></tr></thead>
      <tbody><% for (const p of perProduct) { %>
        <tr><td><a href="/admin/products/<%= p.id %>"><b><%= p.name %></b></a></td><td><span class="tag"><%= p.kind === 'license' ? 'License key' : 'API key' %></span></td>
          <td class="r"><%= fmtNum(p.active) %></td><td class="r"><%= fmtNum(p.units) %></td></tr>
      <% } %></tbody>
    </table>
    <% } %>
  </section>

  <section class="card flush">
    <div class="card-head"><h2>Top usage this month</h2></div>
    <% if (!topUsage.length) { %><div class="empty"><p>No metered usage yet this month.</p></div><% } else { %>
    <table>
      <thead><tr><th>Customer</th><th>Plan</th><th class="r">Used</th><th style="width:120px">Quota</th></tr></thead>
      <tbody><% for (const u of topUsage) { const inc = u.included_units == null ? null : Number(u.included_units); const pct = inc ? Math.min(100, Math.round(Number(u.units) / inc * 100)) : 0; %>
        <tr>
          <td><a href="/admin/customers/<%= encodeURIComponent(u.operator) %>"><%= u.operator %></a></td>
          <td><%= u.product_name %> <small class="muted">· <%= u.plan_name %></small></td>
          <td class="r nowrap"><%= fmtNum(u.units) %> <small class="muted"><%= u.unit_label %></small></td>
          <td><% if (inc) { %><div class="meter <%= pct >= 100 ? 'over' : pct >= 80 ? 'warn' : '' %>"><span style="width:<%= pct %>%"></span></div><small class="muted"><%= pct %>% of <%= fmtNum(inc) %></small><% } else { %><small class="muted"><%= inc === 0 ? 'metered' : 'unlimited' %></small><% } %></td>
        </tr>
      <% } %></tbody>
    </table>
    <% } %>
  </section>
</div>

<section class="card flush">
  <div class="card-head"><h2>Recent subscriptions</h2><a class="small" href="/admin/subscriptions">All →</a></div>
  <% if (!recent.length) { %><div class="empty"><p>No subscriptions yet.</p></div><% } else { %>
  <div class="scroll"><table>
    <thead><tr><th>Customer</th><th>Product · plan</th><th>Billing</th><th>Status</th><th>Renews / ends</th><th>Started</th></tr></thead>
    <tbody><% for (const s of recent) { %>
      <tr>
        <td><a href="/admin/customers/<%= encodeURIComponent(s.operator) %>"><%= s.operator %></a></td>
        <td><b><%= s.product_name %></b> · <%= s.plan_name %></td>
        <td><%= BILLING_LABELS[s.billing] %><% if (Number(s.price_thb)) { %> <small class="muted">฿<%= fmtMoney(s.price_thb) %></small><% } %> <small class="muted">· <%= s.source %></small></td>
        <td><span class="badge b-<%= s.status %>"><%= SUB_STATUS[s.status] %></span><% if (s.cancel_at_period_end) { %> <small class="muted">cancels at period end</small><% } %></td>
        <td class="nowrap muted"><%= fmtDate(s.period_end) %></td>
        <td class="nowrap muted"><%= fmtDate(s.created_at) %></td>
      </tr>
    <% } %></tbody>
  </table></div>
  <% } %>
</section>
<%- include('partials/footer') %>
