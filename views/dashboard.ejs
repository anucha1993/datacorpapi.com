<%- include('partials/header') %>
<div class="pagehead">
  <h1>Overview — <%= ym %></h1>
  <div class="tools">
    <%- include('partials/monthpicker', { action: '/admin' }) %>
    <a class="btn" href="/admin/export.csv?ym=<%= ym %>">⬇ CSV</a>
  </div>
</div>

<% if (typeof coMissing !== 'undefined' && coMissing.length) { %><p class="alert">Business details missing in .env: <%= coMissing.join(', ') %></p><% } %>

<section class="tiles">
  <div class="tile"><div class="k">Total amount</div><div class="v"><%= fmtMoney(totals.amount) %> <small>THB</small></div></div>
  <div class="tile"><div class="k">Billable records</div><div class="v"><%= fmtNum(totals.records) %></div></div>
  <div class="tile"><div class="k">Runs</div><div class="v"><%= fmtNum(totals.runs) %>
    <small class="muted">ok <%= fmtNum(totals.ok) %> · cancelled <%= fmtNum(totals.cancelled) %> · error <%= fmtNum(totals.error) %></small></div></div>
  <div class="tile"><div class="k">Operators / installs</div><div class="v"><%= fmtNum(totals.operators) %> <small>operators</small> / <%= fmtNum(totals.installs) %> <small>machines</small></div></div>
  <div class="tile"><div class="k">Total runtime</div><div class="v"><%= fmtDur(totals.total_sec) %></div></div>
</section>

<div class="grid2">
  <section class="card">
    <h2>By operator</h2>
    <% if (!byOp.length) { %><p class="muted">No data for this month</p><% } else { %>
    <table>
      <thead><tr><th>Operator</th><th class="r">Runs</th><th class="r">Records</th><th class="r">Time</th><th class="r">Amount (THB)</th></tr></thead>
      <tbody>
      <% for (const r of byOp) { %>
        <tr>
          <td><a href="/admin/operator/<%= encodeURIComponent(r.operator) %>?ym=<%= ym %>"><%= r.operator || '(none)' %></a></td>
          <td class="r"><%= fmtNum(r.runs) %></td>
          <td class="r"><%= fmtNum(r.billable_records) %></td>
          <td class="r muted"><%= fmtDur(r.total_sec) %></td>
          <td class="r strong"><%= fmtMoney(r.amount_thb) %></td>
        </tr>
      <% } %>
      </tbody>
      <tfoot><tr><th>Total</th><th class="r"><%= fmtNum(totals.runs) %></th><th class="r"><%= fmtNum(totals.records) %></th><th class="r"><%= fmtDur(totals.total_sec) %></th><th class="r"><%= fmtMoney(totals.amount) %></th></tr></tfoot>
    </table>
    <% } %>
  </section>

  <section class="card">
    <h2>By mode</h2>
    <% if (!byMode.length) { %><p class="muted">No data for this month</p><% } else { %>
    <table>
      <thead><tr><th>Mode</th><th>Group</th><th class="r">Runs</th><th class="r">Records</th><th class="r">Amount (THB)</th></tr></thead>
      <tbody>
      <% for (const r of byMode) { %>
        <tr>
          <td><a href="/admin/runs?ym=<%= ym %>&mode=<%= r.mode %>"><%= r.mode_label %></a></td>
          <td><span class="tag g-<%= r.mode_group %>"><%= GROUP_LABELS[r.mode_group] || r.mode_group %></span></td>
          <td class="r"><%= fmtNum(r.runs) %></td>
          <td class="r"><%= fmtNum(r.billable_records) %></td>
          <td class="r strong"><%= fmtMoney(r.amount_thb) %></td>
        </tr>
      <% } %>
      </tbody>
    </table>
    <% } %>
  </section>
</div>

<% if (daily.length) { %>
<section class="card">
  <h2>Runs per day</h2>
  <div class="bars">
    <% for (const d of daily) { %>
      <div class="bar" title="<%= d.d %> — <%= d.runs %> runs, <%= fmtNum(d.records) %> records">
        <div class="fill" style="height:<%= Math.round(Number(d.runs) / maxDaily * 100) %>%"></div>
        <div class="lbl"><%= String(d.d).slice(8, 10) %></div>
      </div>
    <% } %>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
