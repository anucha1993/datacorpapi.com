<div class="plans <%= plans.length === 1 ? 'single' : '' %>">
  <% for (const p of plans) { %>
  <div class="plan <%= p.featured ? 'featured' : '' %>">
    <div class="pname"><%= p.name_th %> <small>(<%= p.name %>)</small></div>
    <div class="pprice"><%= p.price_label %></div>
    <div class="punit muted"><%= p.unit_label %></div>
    <ul>
      <% for (const f of p.features) { %><li><%= f %></li><% } %>
    </ul>
    <% if (typeof compact !== 'undefined' && compact) { %>
      <a href="/pricing#plan-<%= p.key %>" class="btn <%= p.featured ? 'primary' : '' %>">เลือกแพ็กเกจนี้</a>
    <% } else if (p.checkout_url) { %>
      <form method="get" action="/checkout/<%= p.key %>" class="chk" id="plan-<%= p.key %>">
        <input type="email" name="email" placeholder="อีเมลสำหรับใบเสร็จ" required>
        <input type="text" name="operator" placeholder="ชื่อผู้ใช้งานในโปรแกรม (เช่น ชื่อบริษัท/ชื่อคุณ)" required maxlength="100" pattern="[^\s][^\n]{1,99}">
        <input type="text" name="company" placeholder="ชื่อบริษัท (ถ้ามี)" maxlength="190">
        <button class="btn <%= p.featured ? 'primary' : '' %>">ชำระเงินผ่าน Lemon Squeezy</button>
        <div class="muted small">ชื่อผู้ใช้งานต้องตรงกับช่อง "ผู้ใช้งาน" ในโปรแกรม เพื่อให้ยอดการใช้งานผูกกับบัญชีของคุณ</div>
      </form>
    <% } else { %>
      <a href="/contact" class="btn" id="plan-<%= p.key %>">ติดต่อเพื่อสมัคร</a>
    <% } %>
  </div>
  <% } %>
</div>
