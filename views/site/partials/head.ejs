<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= co.PRODUCT_NAME %></title>
<meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : (co.PRODUCT_NAME + ' — AI-assisted system design, business process automation, web and API development, data pipelines and dashboards. Project-based quotes and pay-as-you-go automation tools. Based in Thailand, working worldwide.') %>">
<% if (co.SITE_URL) { %><link rel="canonical" href="<%= co.SITE_URL %><%= path %>"><% } %>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<link rel="stylesheet" href="/site.css">
</head>
<body class="site">
<header class="sitehead">
  <div class="wrap">
    <a href="/" class="logo"><img src="/logo-mark.png" alt="" width="34" height="34"><span><%= co.PRODUCT_NAME %></span></a>
    <nav>
      <a href="/#services">Services</a>
      <a href="/pricing">Pricing</a>
      <a href="/#process">How we work</a>
      <a href="/#faq">FAQ</a>
      <a href="/contact">Contact</a>
      <a href="/portal/login">Customer login</a>
      <a href="/contact" class="cta">Request a quote</a>
    </nav>
  </div>
</header>
<main class="wrap">
