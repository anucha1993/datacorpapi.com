</main>
<footer class="sitefoot">
  <div class="wrap cols">
    <div>
      <div class="fh"><%= co.PRODUCT_NAME %></div>
      <div class="muted">AI system design · Business automation · Web &amp; API development · Data &amp; dashboards</div>
      <div class="muted" style="margin-top:6px"><%= co.COMPANY_NAME %><% if (co.COMPANY_NAME_EN) { %><br><%= co.COMPANY_NAME_EN %><% } %></div>
      <% if (co.COMPANY_TAX_ID) { %><div class="muted">Tax ID <%= co.COMPANY_TAX_ID %></div><% } %>
      <% if (co.COMPANY_ADDRESS) { %><div class="muted"><%= co.COMPANY_ADDRESS %></div><% } %>
    </div>
    <div>
      <div class="fh">Contact</div>
      <% if (co.COMPANY_EMAIL) { %><div><a href="mailto:<%= co.COMPANY_EMAIL %>"><%= co.COMPANY_EMAIL %></a></div><% } %>
      <% if (co.COMPANY_PHONE) { %><div><a href="tel:<%= co.COMPANY_PHONE.replace(/[^0-9+]/g, '') %>"><%= co.COMPANY_PHONE %></a></div><% } %>
      <% if (co.COMPANY_LINE) { %><div>LINE: <%= co.COMPANY_LINE %></div><% } %>
      <div class="muted"><%= co.SUPPORT_HOURS %></div>
      <div style="margin-top:8px"><a href="/contact">Request a quote</a> · <a href="/portal/login">Customer login</a></div>
    </div>
    <div>
      <div class="fh">Legal</div>
      <div><a href="/terms">Terms of Service</a></div>
      <div><a href="/refund">Refund &amp; Cancellation Policy</a></div>
      <div><a href="/privacy">Privacy Policy</a></div>
      <div><a href="/pricing">Pricing &amp; Billing</a></div>
    </div>
  </div>
  <div class="wrap legal muted">
    © <%= new Date().getFullYear() %> <%= co.COMPANY_NAME || co.PRODUCT_NAME %>. Online payments are processed by our reseller &amp; Merchant of Record, <%= co.PAY.name %>, who also handles order-related inquiries and returns. Card statements will show <%= co.PAY.name %>.
  </div>
</footer>
</body>
</html>
