<%- include('partials/head') %>
<section class="page">
  <h1>Pricing</h1>
  <p class="lead">Simple plans for our APIs and software. All prices are in Thai Baht (THB); any applicable VAT/sales tax is calculated by <%= co.PAY.name %> at checkout based on your country. Pay by <%= co.PAY.paymentMethods %>.</p>

  <% for (const p of products) { %>
  <h2 id="<%= p.slug %>"><%= p.name %></h2>
  <% if (p.tagline) { %><p class="muted"><%= p.tagline %></p><% } %>
  <div class="plans">
    <% for (const pl of p.plans) { const feats = String(pl.features || '').split(/\r?\n/).map(x => x.trim()).filter(Boolean); %>
    <div class="plan <%= pl.is_featured ? 'featured' : '' %>">
      <div class="pname"><%= pl.name %></div>
      <div class="pprice">
        <% if (pl.billing === 'usage') { %>฿<%= fmtUnit(pl.unit_price_thb) %> <small>/ <%= p.unit_label.replace(/s$/, '') %></small>
        <% } else if (!Number(pl.price_thb)) { %>Free
        <% } else { %>฿<%= fmtMoney(pl.price_thb) %> <small>/ <%= pl.billing === 'year' ? 'year' : 'month' %></small><% } %>
      </div>
      <div class="punit muted"><%= BILLING_LABELS[pl.billing] %> · <%= p.kind === 'license' ? 'license key' : 'API key' %></div>
      <ul>
        <li><%= pl.included_units == null ? 'Unlimited ' + p.unit_label : Number(pl.included_units) === 0 ? 'Pay only for the ' + p.unit_label + ' you use' : fmtNum(pl.included_units) + ' ' + p.unit_label + ' per month' + (pl.billing === 'usage' ? ' free' : '') %></li>
        <% if (Number(pl.unit_price_thb) && pl.billing !== 'usage') { %><li>Then ฿<%= fmtUnit(pl.unit_price_thb) %> per extra <%= p.unit_label.replace(/s$/, '') %></li><% } %>
        <% for (const f of feats) { %><li><%= f %></li><% } %>
      </ul>
      <a href="/portal/plans/<%= pl.id %>" class="btn <%= pl.is_featured ? 'primary' : '' %>"><%= Number(pl.price_thb) && pl.billing !== 'usage' ? 'Subscribe' : 'Get started' %></a>
    </div>
    <% } %>
  </div>
  <% } %>
  <% if (!products.length) { %><p class="muted">API and software plans are coming soon. <a href="/contact">Contact us</a> for early access.</p><% } %>
  <p class="muted small center">Subscribing requires a customer account — <a href="/contact">contact us</a> to open one, or <a href="/portal/login">sign in</a>.</p>

  <% if (plans.length) { %>
  <h2>Projects &amp; consulting</h2>
  <div class="plans">
    <% for (const p of plans) { %>
    <div class="plan <%= p.featured ? 'featured' : '' %>" id="plan-<%= p.key %>">
      <div class="pname"><%= p.name %></div>
      <div class="pprice"><%= p.price_label %></div>
      <div class="punit muted"><%= p.unit_label %></div>
      <ul><% for (const f of (p.features || [])) { %><li><%= f %></li><% } %></ul>
      <a href="<%= p.cta_url || '/contact' %>" class="btn"><%= p.cta || 'Request a quote' %></a>
    </div>
    <% } %>
  </div>
  <% } %>

  <h2>How billing works</h2>
  <h3>Monthly and yearly plans</h3>
  <ul class="bullets">
    <li><b>Charged up front</b> when you subscribe, then automatically every month or year until you cancel. The receipt is issued by <%= co.PAY.name %> and can carry your company name, address and tax ID.</li>
    <li><b>Monthly quota</b> resets on the 1st of every month. Plans without overage pricing pause at the quota; plans with overage pricing keep working and the extra usage is invoiced on the 1st of the next month.</li>
    <li><b>Upgrade or switch</b> plans at any time from the customer portal — the price difference is prorated, and your existing keys keep working.</li>
    <li><b>Cancel any time</b> in the customer portal. You keep access until the end of the period you paid for; there is no further charge.</li>
  </ul>
  <h3>Pay-as-you-go plans</h3>
  <ul class="bullets">
    <li>No monthly fee and no card on file. Usage beyond any free allowance is invoiced on the 1st of each month, payable within <%= DUE_DAYS %> days by the payment link in your portal.</li>
    <li>Usage is visible in real time in the customer portal. Monthly amounts below ฿<%= MIN_THB %> are carried forward (payment-provider minimum).</li>
  </ul>
  <h3>Projects</h3>
  <ul class="bullets">
    <li>Written proposal with scope, deliverables, timeline and price; 50% deposit on acceptance and the balance on delivery, invoiced through a <%= co.PAY.name %> payment link.</li>
  </ul>
  <p>Price changes for any recurring plan are announced by email at least 30 days in advance. See the <a href="/refund">Refund &amp; Cancellation Policy</a>.</p>
</section>
<%- include('partials/foot') %>
