<%- include('partials/head') %>
<section class="page">
  <h1>Contact us</h1>
  <div class="grid2 contact">
    <div class="card">
      <h2><%= co.COMPANY_NAME %></h2>
      <% if (co.COMPANY_NAME_EN) { %><p class="muted"><%= co.COMPANY_NAME_EN %></p><% } %>
      <% if (co.COMPANY_ADDRESS) { %><p><%= co.COMPANY_ADDRESS %></p><% } %>
      <% if (co.COMPANY_TAX_ID) { %><p class="muted">Tax ID <%= co.COMPANY_TAX_ID %></p><% } %>
      <p>
        <% if (co.COMPANY_EMAIL) { %>Email: <a href="mailto:<%= co.COMPANY_EMAIL %>"><%= co.COMPANY_EMAIL %></a><br><% } %>
        <% if (co.COMPANY_PHONE) { %>Phone: <a href="tel:<%= co.COMPANY_PHONE.replace(/[^0-9+]/g, '') %>"><%= co.COMPANY_PHONE %></a><br><% } %>
        <% if (co.COMPANY_LINE) { %>LINE: <%= co.COMPANY_LINE %><br><% } %>
        Support hours: <%= co.SUPPORT_HOURS %>
      </p>
      <p class="muted">For a quote, tell us what you want to build or automate, which systems are involved and your rough timeline; we reply within 1 business day with next steps or a proposal.
        For payments, receipts or refunds, contact us directly or use the links in your Lemon Squeezy receipt email (Lemon Squeezy is the Merchant of Record).</p>
    </div>
    <div class="card">
      <h2>Send a message</h2>
      <% if (sent) { %>
        <p class="ok">Message received. We will reply by email within 1 business day.</p>
      <% } else { %>
      <% if (error) { %><p class="alert"><%= error %></p><% } %>
      <form method="post" action="/contact" class="stack">
        <input type="text" name="name" placeholder="Your name" required maxlength="190" value="<%= form.name || '' %>">
        <input type="email" name="email" placeholder="Email" required maxlength="190" value="<%= form.email || '' %>">
        <input type="text" name="company" placeholder="Company (optional)" maxlength="190" value="<%= form.company || '' %>">
        <textarea name="message" rows="6" placeholder="What would you like to build or automate? Systems involved, volume, timeline, or your invoice number if this is a billing question" required maxlength="4000"><%= form.message || '' %></textarea>
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off">
        <button class="btn primary">Send</button>
      </form>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
