<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <h1>Customers</h1>
    <p class="subtitle"><%= rows.length %> accounts · login at <code><%= siteUrl %>/portal/login</code></p>
  </div>
  <div class="tools"><a class="btn primary" href="#new" onclick="document.getElementById('new').open=true">+ New customer</a></div>
</div>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (error) { %><p class="alert"><%= error %></p><% } %>

<details class="card" id="new" <%= error ? 'open' : '' %>>
  <summary class="card-head" style="cursor:pointer;margin:0"><h2>Create account / reset password</h2><span class="muted small">submitting an existing username resets its password</span></summary>
  <form method="post" action="/admin/customers" style="margin-top:16px">
    <div class="form-grid stack" style="display:grid">
      <label>Username <span class="hint">Used to sign in to the portal</span><input name="operator" placeholder="acme" required maxlength="100"></label>
      <label>Password <span class="hint">At least 6 characters</span><input name="password" required minlength="6"></label>
      <label>Display name<input name="display_name" placeholder="Acme Co., Ltd." maxlength="190"></label>
      <label>Email<input name="email" type="email" maxlength="190"></label>
      <label class="check full"><input type="checkbox" name="must_change" value="1" checked> <span>Require password change at first login</span></label>
    </div>
    <hr class="divider">
    <button class="primary">Save account</button>
  </form>
</details>

<section class="card flush">
  <% if (!rows.length) { %><div class="empty"><h3>No customers yet</h3></div><% } else { %>
  <div class="scroll"><table>
    <thead><tr><th>Customer</th><th>Plans</th><th class="r">Owed</th><th>Serial (SN)</th><th>Last login</th><th>Status</th><th class="r"></th></tr></thead>
    <tbody>
    <% for (const u of rows) { %>
      <tr class="<%= u.is_active ? '' : 'hl' %>">
        <td><a href="/admin/customers/<%= encodeURIComponent(u.operator) %>"><b><%= u.operator %></b></a><br><small class="muted"><%= u.company_name || u.display_name %><%= u.email ? ' · ' + u.email : '' %></small></td>
        <td><%= Number(u.subs) ? u.subs + ' active' : '—' %></td>
        <td class="r <%= Number(u.owed) ? 'strong' : 'muted' %>"><%= Number(u.owed) ? '฿' + fmtMoney(u.owed) : '—' %></td>
        <td class="nowrap"><code><%= u.serial_no || '—' %></code><br><small class="muted"><%= u.devices %> device<%= Number(u.devices) === 1 ? '' : 's' %><% if (u.last_verified_at) { %> · verified <%= fmtDate(u.last_verified_at) %><% } %></small></td>
        <td class="muted nowrap"><%= u.last_login_at ? fmtDate(u.last_login_at) : '—' %></td>
        <td><span class="badge b-<%= u.is_active ? 'active' : 'void' %>"><%= u.is_active ? 'Active' : 'Disabled' %></span><% if (u.must_change) { %><br><small class="muted">password change pending</small><% } %></td>
        <td class="r nowrap">
          <a class="btn small" href="/admin/customers/<%= encodeURIComponent(u.operator) %>">Manage</a>
          <form method="post" action="/admin/customers/<%= u.id %>/serial" class="inline" onsubmit="return confirm('Issue a NEW serial number? The current one stops working on all of this customer\'s machines.')"><button class="btn small">New SN</button></form>
          <form method="post" action="/admin/customers/<%= u.id %>/toggle" class="inline"><button class="btn small <%= u.is_active ? 'danger' : '' %>"><%= u.is_active ? 'Disable' : 'Enable' %></button></form>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table></div>
  <% } %>
</section>
<%- include('partials/footer') %>
