<%- include('partials/header') %>
<div class="pagehead"><h1>Unit prices</h1></div>
<% if (saved) { %><p class="ok">Prices saved — amounts on every page are recalculated immediately (including past months).</p><% } %>
<form method="post" action="/admin/prices" class="card">
  <p class="muted">Amount = billable records × price per record + runs × price per run.<br>
  Cancelled or failed jobs are billed for the records completed (progress), not zero.</p>
  <table>
    <thead><tr><th>Mode</th><th>Label</th><th class="r">Price / record (THB)</th><th class="r">Price / run (THB)</th></tr></thead>
    <tbody>
    <% for (const p of prices) { %>
      <tr>
        <td><code><%= p.mode %></code><input type="hidden" name="mode" value="<%= p.mode %>"></td>
        <td><input name="mode_label" value="<%= p.mode_label %>" class="w"></td>
        <td class="r"><input name="price_per_record" type="number" step="0.01" min="0" value="<%= p.price_per_record %>" class="num"></td>
        <td class="r"><input name="price_per_run" type="number" step="0.01" min="0" value="<%= p.price_per_run %>" class="num"></td>
      </tr>
    <% } %>
    <% for (const m of missing) { %>
      <tr class="hl">
        <td><code><%= m %></code> <small class="muted">(no price yet)</small><input type="hidden" name="mode" value="<%= m %>"></td>
        <td><input name="mode_label" value="<%= MODE_LABELS[m] %>" class="w"></td>
        <td class="r"><input name="price_per_record" type="number" step="0.01" min="0" value="0" class="num"></td>
        <td class="r"><input name="price_per_run" type="number" step="0.01" min="0" value="0" class="num"></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <div class="actions"><button class="primary">Save prices</button></div>
</form>
<%- include('partials/footer') %>
