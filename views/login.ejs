<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin sign in</title>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/style.css">
</head>
<body class="center">
<form method="post" action="/login" class="card login">
  <h1>Admin</h1>
  <p class="muted">Usage, invoices and customer management — enter the admin password</p>
  <% if (error) { %><p class="alert"><%= error %></p><% } %>
  <input type="password" name="password" placeholder="Password" autofocus required>
  <button class="primary">Sign in</button>
  <p class="muted small"><a href="/portal/login">Customer login</a> · <a href="/">Website</a></p>
</form>
</body>
</html>
