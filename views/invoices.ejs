<%- include('partials/header') %>
<div class="pagehead">
  <h1>Invoices <span class="muted">· <%= ym %></span></h1>
  <div class="tools">
    <form method="get" class="monthpick" action="/admin/invoices">
      <label>Month <select name="ym" onchange="this.form.submit()"><% for (const m of months) { %><option value="<%= m %>" <%= m === ym ? 'selected' : '' %>><%= m %></option><% } %></select></label>
    </form>
    <form method="post" action="/admin/invoices/generate" onsubmit="return confirm('Generate / refresh invoices for <%= ym %> for every customer with usage?')">
      <input type="hidden" name="ym" value="<%= ym %>">
      <button class="primary">Generate invoices for this month</button>
    </form>
  </div>
</div>

<% if (!lsReady) { %><p class="alert"><code>LS_API_KEY</code> is not set — invoices can be generated but will have no Lemon Squeezy payment link</p><% } %>
<% if (testMode) { %><p class="notice">🧪 Test mode (LS_TEST_MODE=true): payment links are Lemon Squeezy test checkouts — pay with card 4242 4242 4242 4242, no real money is charged. Set LS_TEST_MODE=false to go live.</p><% } %>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (error) { %><p class="alert"><%= error %></p><% } %>

<% if (report) { %>
<section class="card">
  <h2>Generation result</h2>
  <table class="dense"><thead><tr><th>Operator</th><th>Invoice</th><th class="r">Records</th><th class="r">Usage</th><th class="r">Carried</th><th class="r">Amount</th><th>Status</th><th>Note</th></tr></thead><tbody>
  <% for (const r of report) { %>
    <tr><td><%= r.operator %></td><td><%= r.invoice_no %></td><td class="r"><%= fmtNum(r.records) %></td><td class="r"><%= fmtMoney(r.usage) %></td><td class="r"><%= fmtMoney(r.carried) %></td><td class="r strong"><%= fmtMoney(r.amount) %></td>
      <td><span class="st st-<%= r.status === 'open' ? 'cancelled' : r.status === 'paid' ? 'ok' : 'error' %>"><%= STATUS_INV[r.status] || r.status %></span></td><td class="muted"><%= r.message %></td></tr>
  <% } %>
  </tbody></table>
</section>
<% } %>

<section class="card">
  <details <%= error ? 'open' : '' %>>
    <summary class="btn">+ Create invoice with a custom amount</summary>
    <form method="post" action="/admin/invoices/manual" class="filters" style="margin-top:10px">
      <label>Customer (operator) <input name="operator" list="ops" required maxlength="100" placeholder="thefirst"></label>
      <datalist id="ops"><% for (const o of operators) { %><option value="<%= o %>"><% } %></datalist>
      <label>Amount (THB) <input name="amount" type="number" step="0.01" min="<%= MIN_THB %>" required class="num" placeholder="500"></label>
      <label>Title (shown to customer) <input name="title" maxlength="190" placeholder="Setup & training" required></label>
      <label>Note (optional) <input name="note" maxlength="500" placeholder="Details…" style="min-width:260px"></label>
      <label>Due in (days) <input name="due_days" type="number" min="1" max="90" value="<%= DUE_DAYS %>" class="num"></label>
      <button class="primary">Create invoice + payment link</button>
    </form>
    <p class="muted small">Use this for one-off charges (setup, training, agreed amounts). Monthly usage invoices are generated automatically with the button above.</p>
  </details>
</section>

<section class="tiles">
  <div class="tile"><div class="k">Unpaid</div><div class="v"><%= fmtMoney(sum.open) %> <small>THB · <%= sum.open_n %></small></div></div>
  <div class="tile"><div class="k">Paid</div><div class="v"><%= fmtMoney(sum.paid) %> <small>THB · <%= sum.paid_n %></small></div></div>
  <div class="tile"><div class="k">Overdue</div><div class="v"><%= fmtNum(sum.overdue_n) %> <small>invoices</small></div></div>
  <div class="tile"><div class="k">Carried to next month</div><div class="v"><%= fmtMoney(sum.carried) %> <small>THB</small></div></div>
</section>

<section class="card">
  <% if (!rows.length) { %><p class="muted">No invoices for this month yet — click "Generate invoices" (normally on the 1st of the following month, or let the cron job do it).</p><% } else { %>
  <div class="scroll"><table class="dense">
    <thead><tr><th>Invoice</th><th>Operator</th><th class="r">Records</th><th class="r">Usage</th><th class="r">Carried</th><th class="r">Adj.</th><th class="r">Amount</th><th>Due</th><th>Status</th><th>Payment link</th><th>Actions</th></tr></thead>
    <tbody>
    <% for (const r of rows) { const overdue = r.status === 'open' && r.due_at && r.due_at < today; %>
      <tr class="<%= overdue ? 'hl' : '' %>">
        <td class="nowrap"><%= r.invoice_no %><% if (r.kind === 'manual') { %> <span class="tag">manual</span><% } %><% if (r.checkout_test) { %> <small class="muted">test</small><% } %><% if (r.title) { %><br><small class="muted"><%= r.title %></small><% } %></td>
        <td><a href="/admin/operator/<%= encodeURIComponent(r.operator) %>?ym=<%= r.ym %>"><%= r.operator %></a><% if (r.company_name) { %><br><small class="muted"><%= r.company_name %></small><% } %></td>
        <td class="r"><%= fmtNum(r.records) %></td>
        <td class="r"><%= fmtMoney(r.usage_thb) %></td>
        <td class="r muted"><%= Number(r.carried_thb) ? fmtMoney(r.carried_thb) : '—' %></td>
        <td class="r muted"><%= Number(r.adjust_thb) ? fmtMoney(r.adjust_thb) : '—' %></td>
        <td class="r strong"><%= fmtMoney(r.amount_thb) %></td>
        <td class="nowrap muted"><%= r.due_at || '' %><% if (overdue) { %> <span class="st st-error">Overdue</span><% } %></td>
        <td><span class="st st-<%= r.status === 'open' ? 'cancelled' : r.status === 'paid' ? 'ok' : 'error' %>"><%= STATUS_INV[r.status] || r.status %></span>
          <% if (r.status === 'paid') { %><br><small class="muted"><%= r.paid_via %> <%= r.paid_at || '' %></small><% } %></td>
        <td><% if (r.checkout_url) { %><a href="<%= r.checkout_url %>" target="_blank" rel="noopener">Open ↗</a> · <button type="button" class="link" onclick="navigator.clipboard.writeText('<%= r.checkout_url %>');this.textContent='Copied'">Copy</button><% } else if (r.status === 'open') { %><form method="post" action="/admin/invoices/<%= r.id %>/link" class="inline"><button>Create link</button></form><% } else { %><span class="muted">—</span><% } %></td>
        <td class="nowrap">
          <% if (r.status !== 'paid') { %>
            <details class="inlinedetails"><summary class="btn small">Adjust</summary>
              <form method="post" action="/admin/invoices/<%= r.id %>/adjust" class="stack" style="margin-top:6px;min-width:220px">
                <input name="adjust_thb" type="number" step="0.01" value="<%= r.adjust_thb %>" placeholder="Adjustment (+/-) THB">
                <input name="note" value="<%= r.note %>" placeholder="Note (visible to customer)" maxlength="500">
                <button class="primary">Save + new link</button>
              </form>
            </details>
            <form method="post" action="/admin/invoices/<%= r.id %>/paid" class="inline" onsubmit="return confirm('Mark as paid (received by other means, e.g. bank transfer)?')"><button>Mark paid</button></form>
            <form method="post" action="/admin/invoices/<%= r.id %>/void" class="inline" onsubmit="return confirm('Void this invoice?')"><button class="link">Void</button></form>
          <% } %>
        </td>
      </tr>
      <% if (r.note) { %><tr><td></td><td colspan="10" class="muted small">Note: <%= r.note %></td></tr><% } %>
    <% } %>
    </tbody>
  </table></div>
  <% } %>
</section>
<p class="muted small">Minimum per invoice ฿<%= MIN_THB %> (Lemon Squeezy requirement) — smaller amounts are carried forward automatically · due <%= DUE_DAYS %> days after issue · cron: <code>node invoices.js</code> on the 1st of each month</p>
<%- include('partials/footer') %>
