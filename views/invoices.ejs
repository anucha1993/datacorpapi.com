<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <h1>Invoices</h1>
    <p class="subtitle"><%= ym === 'all' ? 'All months' : ym %><%= filters.status ? ' · ' + filters.status : '' %><%= filters.operator ? ' · ' + filters.operator : '' %> — <%= rows.length %> invoice<%= rows.length === 1 ? '' : 's' %></p>
  </div>
  <div class="tools">
    <a class="btn primary" href="#new" onclick="document.getElementById('new').open=true">+ New invoice</a>
    <% if (ym !== 'all') { %>
    <form method="post" action="/admin/invoices/generate" onsubmit="return confirm('Create / refresh usage invoices for <%= ym %> (usage over quota and pay-as-you-go plans)?')">
      <input type="hidden" name="ym" value="<%= ym %>">
      <button>Bill usage for <%= ym %></button>
    </form>
    <% } %>
  </div>
</div>

<% if (!lsReady) { %><p class="alert"><code><%= pay.envApi %></code> is not set — invoices can be created but will have no <%= pay.name %> payment link (services with a pasted Polar link still work).</p><% } %>
<% if (testMode) { %><p class="notice">Test mode (<%= pay.envTest %>): payment links are <%= pay.name %> test checkouts — pay with card 4242 4242 4242 4242, no real money is charged.<% if (pay.key === 'polar') { %> Set POLAR_SERVER=production (with a production token) to go live.<% } else { %> Set LS_TEST_MODE=false to go live.<% } %></p><% } %>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (error) { %><p class="alert"><%= error %></p><% } %>

<% if (report) { %>
<section class="card">
  <h2>Generation result</h2>
  <div class="scroll"><table class="dense"><thead><tr><th>Operator</th><th>Invoice</th><th class="r">Records</th><th class="r">Usage</th><th class="r">Carried</th><th class="r">Amount</th><th>Status</th><th>Note</th></tr></thead><tbody>
  <% for (const r of report) { %>
    <tr><td><%= r.operator %></td><td><%= r.invoice_no %></td><td class="r"><%= fmtNum(r.records) %></td><td class="r"><%= fmtMoney(r.usage) %></td><td class="r"><%= fmtMoney(r.carried) %></td><td class="r strong"><%= fmtMoney(r.amount) %></td>
      <td><span class="badge b-<%= r.status %>"><%= STATUS_INV[r.status] || r.status %></span></td><td class="muted"><%= r.message %></td></tr>
  <% } %>
  </tbody></table></div>
</section>
<% } %>

<details class="card" id="new" <%= error ? 'open' : '' %>>
  <summary class="card-head" style="cursor:pointer;margin:0"><h2>Create an invoice for a customer</h2><span class="muted small">one-off charge · service · agreed amount</span></summary>
  <form method="post" action="/admin/invoices/manual" style="margin-top:16px">
    <div class="form-grid stack" style="display:grid">
      <label>Customer (operator)
        <input name="operator" list="ops" required maxlength="100" placeholder="Start typing…" value="<%= filters.operator %>">
        <datalist id="ops"><% for (const o of operators) { %><option value="<%= o %>"><% } %></datalist></label>
      <label>From service catalog <span class="hint">Optional — fills title, description and price</span>
        <select name="service_id" id="svcpick">
          <option value="">— Custom charge —</option>
          <% for (const s of services) { %><option value="<%= s.id %>" data-name="<%= s.name %>" data-price="<%= s.price_thb %>" data-desc="<%= s.description %>"><%= s.name %> · ฿<%= fmtMoney(s.price_thb) %><%= s.payment_link ? ' · Polar link' : '' %></option><% } %>
        </select></label>
      <label>Title <span class="hint">Shown to the customer</span><input name="title" maxlength="190" placeholder="Setup &amp; training"></label>
      <label>Amount (THB) <span class="hint">Minimum ฿<%= MIN_THB %></span><input name="amount" type="number" step="0.01" min="<%= MIN_THB %>" placeholder="500.00"></label>
      <label class="full">Description <span class="hint">Optional — appears on the invoice</span><textarea name="note" maxlength="500" rows="2"></textarea></label>
      <label>Due in (days)<input name="due_days" type="number" min="1" max="90" value="<%= DUE_DAYS %>"></label>
    </div>
    <hr class="divider">
    <div class="btnrow"><button class="primary">Create invoice + payment link</button><span class="muted small">The customer sees it under Invoices &amp; payments in the portal and can pay right away. You'll land on the invoice to copy the link or attach a receipt.</span></div>
  </form>
  <script>
    document.getElementById('svcpick').addEventListener('change', function () {
      const o = this.selectedOptions[0], f = this.form;
      if (!o.value) return;
      f.title.value = o.dataset.name; f.amount.value = o.dataset.price; f.note.value = o.dataset.desc || '';
    });
  </script>
</details>

<section class="tiles">
  <div class="tile"><div class="k">Unpaid</div><div class="v"><%= fmtMoney(sum.open) %> <small>THB · <%= sum.open_n %></small></div></div>
  <div class="tile"><div class="k">Paid</div><div class="v"><%= fmtMoney(sum.paid) %> <small>THB · <%= sum.paid_n %></small></div></div>
  <div class="tile"><div class="k">Overdue</div><div class="v"><%= fmtNum(sum.overdue_n) %> <small>invoices</small></div></div>
  <div class="tile"><div class="k">Carried to next month (all)</div><div class="v"><%= fmtMoney(sum.carried) %> <small>THB</small></div></div>
</section>

<section class="card flush">
  <form method="get" action="/admin/invoices" class="filters" style="padding:16px 20px;border-bottom:1px solid var(--border)">
    <label>Month <select name="ym"><option value="all" <%= ym === 'all' ? 'selected' : '' %>>All months</option><% for (const m of months) { %><option value="<%= m %>" <%= m === ym ? 'selected' : '' %>><%= m %></option><% } %></select></label>
    <label>Status <select name="status">
      <% for (const [k, v] of [['', 'Any'], ['open', 'Unpaid'], ['overdue', 'Overdue'], ['paid', 'Paid'], ['carried', 'Carried forward'], ['void', 'Void'], ['subscription', 'Subscription charges'], ['usage', 'Usage charges'], ['manual', 'Services / custom']]) { %><option value="<%= k %>" <%= filters.status === k ? 'selected' : '' %>><%= v %></option><% } %>
    </select></label>
    <label>Customer <input name="operator" list="ops" value="<%= filters.operator %>" placeholder="All customers"></label>
    <button>Filter</button>
    <% if (filters.status || filters.operator || ym === 'all') { %><a class="btn" href="/admin/invoices">Reset</a><% } %>
  </form>
  <% if (!rows.length) { %><div class="empty"><h3>No invoices match</h3><p>Subscription charges appear automatically when Polar bills a plan. Usage over quota is invoiced with "Bill usage" (or the cron job on the 1st). Use "New invoice" for one-off charges.</p></div><% } else { %>
  <div class="scroll"><table>
    <thead><tr><th>Invoice</th><th>Customer</th><th>Description</th><th class="r">Amount (THB)</th><th>Issued</th><th>Due</th><th>Status</th><th>Receipt</th><th class="r"></th></tr></thead>
    <tbody>
    <% for (const r of rows) { const overdue = r.status === 'open' && r.due_at && r.due_at < today; %>
      <tr class="<%= overdue ? 'hl' : '' %>">
        <td class="nowrap"><a class="linkish mono" href="/admin/invoices/<%= r.id %>"><%= r.invoice_no %></a><% if (r.checkout_test) { %> <span class="badge b-test">test</span><% } %></td>
        <td><a href="/admin/customers/<%= encodeURIComponent(r.operator) %>"><%= r.operator %></a><% if (r.company_name) { %><br><small class="muted"><%= r.company_name %></small><% } %></td>
        <td><%= r.title || (r.kind === 'manual' ? 'Custom charge' : 'Usage ' + r.ym) %><% if (r.kind === 'usage') { %><br><small class="muted"><%= fmtNum(r.records) %> billable units<%= Number(r.carried_thb) ? ' · carried ' + fmtMoney(r.carried_thb) : '' %><%= Number(r.adjust_thb) ? ' · adj. ' + fmtMoney(r.adjust_thb) : '' %></small><% } %></td>
        <td class="r strong"><%= fmtMoney(r.amount_thb) %></td>
        <td class="nowrap muted"><%= String(r.issued_at || '').slice(0, 10) %></td>
        <td class="nowrap muted"><%= r.due_at || '' %></td>
        <td><span class="badge b-<%= overdue ? 'overdue' : r.status %>"><%= overdue ? 'Overdue' : (STATUS_INV[r.status] || r.status) %></span><% if (r.status === 'paid') { %><br><small class="muted"><%= r.paid_via %> <%= String(r.paid_at || '').slice(0, 10) %></small><% } %></td>
        <td class="nowrap"><% if (r.receipt_url) { %><a href="<%= r.receipt_url %>" target="_blank" rel="noopener">Provider ↗</a><% } %><% if (Number(r.files)) { %><%= r.receipt_url ? ' · ' : '' %><%= r.files %> file<%= Number(r.files) === 1 ? '' : 's' %><% } %><% if (!r.receipt_url && !Number(r.files)) { %><span class="muted">—</span><% } %></td>
        <td class="r nowrap">
          <% if (r.status === 'open' && r.checkout_url) { %><button type="button" class="btn small" onclick="navigator.clipboard.writeText(<%= JSON.stringify(r.checkout_url) %>);this.textContent='Copied'">Copy pay link</button><% } %>
          <a class="btn small" href="/admin/invoices/<%= r.id %>">Manage</a>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table></div>
  <% } %>
</section>
<p class="muted small">Minimum per invoice ฿<%= MIN_THB %> (payment-provider minimum) — smaller usage amounts are carried forward automatically · due <%= DUE_DAYS %> days after issue · cron: <code>node invoices.js</code> on the 1st of each month</p>
<%- include('partials/footer') %>
