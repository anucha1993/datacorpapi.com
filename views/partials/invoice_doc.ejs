<%# Printable invoice document — locals: co, inv, buyer, lines, overdue %>
<% const subtotal = lines.reduce((s, l) => s + Number(l.amount || 0), 0); %>
<article class="doc">
  <header class="doc-head">
    <div class="doc-brand">
      <span class="brand-mark"><%= (co.PRODUCT_NAME || 'P').charAt(0) %></span>
      <div>
        <b><%= co.COMPANY_NAME_EN || co.COMPANY_NAME || co.PRODUCT_NAME %></b>
        <div class="muted">
          <% if (co.COMPANY_ADDRESS) { %><%= co.COMPANY_ADDRESS %><br><% } %>
          <% if (co.COMPANY_TAX_ID) { %>Tax ID <%= co.COMPANY_TAX_ID %><br><% } %>
          <%= [co.COMPANY_EMAIL, co.COMPANY_PHONE].filter(Boolean).join(' · ') %>
        </div>
      </div>
    </div>
    <div class="doc-title">
      <h2>INVOICE</h2>
      <div class="no"><%= inv.invoice_no %></div>
      <% if (inv.status === 'paid') { %><div class="stamp paid">PAID</div>
      <% } else if (inv.status === 'void') { %><div class="stamp void">VOID</div>
      <% } else if (overdue) { %><div class="stamp overdue">OVERDUE</div><% } %>
    </div>
  </header>

  <section class="doc-parties">
    <div>
      <div class="section-title">Bill to</div>
      <p><b><%= buyer.company_name || buyer.display_name || inv.operator %></b><br>
        <% if (buyer.address) { %><%= buyer.address %><% if (buyer.zip) { %> <%= buyer.zip %><% } %><br><% } %>
        <% if (buyer.tax_id) { %>Tax ID <%= buyer.tax_id %><br><% } %>
        <% if (buyer.billing_email || buyer.email) { %><%= buyer.billing_email || buyer.email %><br><% } %>
        <span class="muted">Account: <%= inv.operator %></span></p>
    </div>
    <div>
      <div class="section-title">Payment</div>
      <p>
        <% if (inv.status === 'paid') { %>Paid <%= String(inv.paid_at || '').slice(0, 10) %><% if (inv.paid_via) { %> via <%= inv.paid_via === 'polar' ? 'Polar' : inv.paid_via === 'lemonsqueezy' ? 'Lemon Squeezy' : inv.paid_via === 'manual' ? 'bank transfer / other' : inv.paid_via %><% } %>
        <% } else if (inv.status === 'open') { %>Pay online by <%= co.PAY.paymentMethods %> via <%= co.PAY.name %> (Merchant of Record).
        <% } else if (inv.status === 'carried') { %>Below the ฿<%= MIN_THB %> payment minimum — carried forward to your next invoice.
        <% } else { %>This invoice has been cancelled. No payment is due.<% } %>
      </p>
    </div>
  </section>

  <div class="doc-meta">
    <div><div class="k">Issue date</div><div class="v"><%= String(inv.issued_at || '').slice(0, 10) %></div></div>
    <div><div class="k">Due date</div><div class="v"><%= inv.due_at || '—' %></div></div>
    <div><div class="k"><%= inv.kind === 'usage' ? 'Period' : 'Type' %></div><div class="v"><%= inv.kind === 'usage' ? inv.ym : inv.kind === 'subscription' ? 'Subscription' : 'Service' %></div></div>
    <div><div class="k">Status</div><div class="v"><span class="badge b-<%= overdue ? 'overdue' : inv.status %>"><%= overdue ? 'Overdue' : (STATUS_INV[inv.status] || inv.status) %></span></div></div>
  </div>

  <div class="scroll"><table>
    <thead><tr><th>Description</th><th class="r">Qty</th><th class="r">Unit price</th><th class="r">Amount (THB)</th></tr></thead>
    <tbody>
    <% if (!lines.length) { %><tr><td colspan="4" class="muted">No billable items</td></tr><% } %>
    <% for (const l of lines) { %>
      <tr>
        <td><b><%= l.name %></b><% if (l.desc) { %><br><small class="muted"><%= l.desc %></small><% } %></td>
        <td class="r"><%= fmtNum(l.qty) %></td>
        <td class="r"><%= l.unit != null ? (l.unitPrecise ? fmtUnit(l.unit) : fmtMoney(l.unit)) : '—' %></td>
        <td class="r strong"><%= fmtMoney(l.amount) %></td>
      </tr>
    <% } %>
    </tbody>
  </table></div>

  <div class="doc-totals">
    <% if (Math.abs(subtotal - Number(inv.amount_thb)) >= 0.01) { %><div class="line"><span class="muted">Subtotal</span><span><%= fmtMoney(subtotal) %></span></div><% } %>
    <div class="line total"><span>Total due</span><span>฿<%= fmtMoney(inv.amount_thb) %></span></div>
    <div class="line muted small"><span>Currency</span><span>Thai Baht (THB)</span></div>
  </div>

  <% if (inv.note && inv.kind !== 'manual') { %><p class="small muted" style="margin-top:16px"><b>Note:</b> <%= inv.note %></p><% } %>

  <footer class="doc-foot">
    Online payments are processed by <%= co.PAY.legalName %>, which acts as Merchant of Record and issues the official payment receipt for card payments.
    Questions about this invoice? Contact <%= co.COMPANY_EMAIL || 'support' %> and quote <b><%= inv.invoice_no %></b>.
  </footer>
</article>
