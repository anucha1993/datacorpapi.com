<%# Payment request shown under the Merchant of Record (Polar) — NOT our own invoice/tax document.
    The official invoice/receipt is issued by Polar after payment (inv.receipt_url). locals: co, inv, buyer, lines, overdue %>
<% const subtotal = lines.reduce((s, l) => s + Number(l.amount || 0), 0); const isPaid = inv.status === 'paid'; %>
<article class="doc">
  <header class="doc-head">
    <div class="doc-brand">
      <span class="polar-mark" aria-hidden="true">P</span>
      <div>
        <b><%= co.PAY.key === 'polar' ? 'polar.sh' : co.PAY.name %></b>
        <div class="muted">
          <%= co.PAY.legalName %> · Merchant of Record<br>
          Payments and official invoices/receipts are issued by <%= co.PAY.legalName %>
        </div>
      </div>
    </div>
    <div class="doc-title">
      <h2><%= isPaid ? 'PAYMENT CONFIRMED' : 'PAYMENT REQUEST' %></h2>
      <div class="no">Ref. <%= inv.invoice_no %></div>
      <% if (isPaid) { %><div class="stamp paid">PAID</div>
      <% } else if (inv.status === 'void') { %><div class="stamp void">VOID</div>
      <% } else if (overdue) { %><div class="stamp overdue">OVERDUE</div><% } %>
    </div>
  </header>

  <section class="doc-parties">
    <div>
      <div class="section-title">Customer</div>
      <p><b><%= buyer.company_name || buyer.display_name || inv.operator %></b><br>
        <% if (buyer.billing_email || buyer.email) { %><%= buyer.billing_email || buyer.email %><br><% } %>
        <span class="muted">Account: <%= inv.operator %></span></p>
    </div>
    <div>
      <div class="section-title">Payment</div>
      <p>
        <% if (isPaid) { %>Paid <%= String(inv.paid_at || '').slice(0, 10) %><% if (inv.paid_via) { %> via <%= inv.paid_via === 'polar' ? 'Polar' : inv.paid_via === 'lemonsqueezy' ? 'Lemon Squeezy' : inv.paid_via === 'manual' ? 'bank transfer / other' : inv.paid_via %><% } %>
          <% if (inv.receipt_url) { %><br><a href="<%= inv.receipt_url %>" target="_blank" rel="noopener">Official invoice / receipt from <%= co.PAY.name %> ↗</a><% } %>
        <% } else if (inv.status === 'open') { %>Pay online by <%= co.PAY.paymentMethods %> on <%= co.PAY.name %>'s secure checkout. <%= co.PAY.legalName %> issues the official invoice/receipt with your company details when the payment completes.
        <% } else if (inv.status === 'carried') { %>Below the ฿<%= MIN_THB %> payment minimum — carried forward to your next payment request.
        <% } else { %>This payment request has been cancelled. No payment is due.<% } %>
      </p>
    </div>
  </section>

  <div class="doc-meta">
    <div><div class="k">Requested</div><div class="v"><%= String(inv.issued_at || '').slice(0, 10) %></div></div>
    <div><div class="k">Due date</div><div class="v"><%= inv.due_at || '—' %></div></div>
    <div><div class="k"><%= inv.kind === 'usage' ? 'Period' : 'Type' %></div><div class="v"><%= inv.kind === 'usage' ? inv.ym : inv.kind === 'subscription' ? 'Subscription' : 'Service' %></div></div>
    <div><div class="k">Status</div><div class="v"><span class="badge b-<%= overdue ? 'overdue' : inv.status %>"><%= overdue ? 'Overdue' : (STATUS_INV[inv.status] || inv.status) %></span></div></div>
  </div>

  <div class="scroll"><table>
    <thead><tr><th>Description</th><th class="r">Qty</th><th class="r">Unit price</th><th class="r">Amount (THB)</th></tr></thead>
    <tbody>
    <% if (!lines.length) { %><tr><td colspan="4" class="muted">No items</td></tr><% } %>
    <% for (const l of lines) { %>
      <tr>
        <td><b><%= l.name %></b><% if (l.desc) { %><br><small class="muted"><%= l.desc %></small><% } %></td>
        <td class="r"><%= fmtNum(l.qty) %></td>
        <td class="r"><%= l.unit != null ? (l.unitPrecise ? fmtUnit(l.unit) : fmtMoney(l.unit)) : '—' %></td>
        <td class="r strong"><%= fmtMoney(l.amount) %></td>
      </tr>
    <% } %>
    </tbody>
  </table></div>

  <div class="doc-totals">
    <% if (Math.abs(subtotal - Number(inv.amount_thb)) >= 0.01) { %><div class="line"><span class="muted">Subtotal</span><span><%= fmtMoney(subtotal) %></span></div><% } %>
    <div class="line total"><span><%= isPaid ? 'Amount paid' : 'Amount to pay' %></span><span>฿<%= fmtMoney(inv.amount_thb) %></span></div>
    <div class="line muted small"><span>Currency</span><span>Thai Baht (THB)</span></div>
  </div>

  <% if (inv.note && inv.kind !== 'manual') { %><p class="small muted" style="margin-top:16px"><b>Note:</b> <%= inv.note %></p><% } %>

  <footer class="doc-foot">
    This page is a payment request, not a tax invoice. <%= co.PAY.legalName %> (<%= co.PAY.key === 'polar' ? 'polar.sh' : co.PAY.name %>) is the Merchant of Record for this purchase
    and issues the official invoice/receipt. Questions? Contact <%= co.COMPANY_EMAIL || 'support' %> and quote <b><%= inv.invoice_no %></b>.
  </footer>
</article>
