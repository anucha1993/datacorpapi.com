<%- include('partials/header') %>
<div class="pagehead">
  <h1>Lemon Squeezy <span class="muted">· customers / orders / webhooks</span></h1>
  <div class="tools">
    <a class="btn" href="/admin/invoices">Go to invoices →</a>
  </div>
</div>

<% if (!lsReady || !webhookReady) { %>
<p class="alert">
  <% if (!lsReady) { %><code>LS_API_KEY</code> is not set — payment links cannot be created<br><% } %>
  <% if (!webhookReady) { %><code>LS_WEBHOOK_SECRET</code> is not set — webhooks will be rejected (503)<% } %>
</p>
<% } %>

<section class="card">
  <h2>Subscriptions <span class="muted">(<%= subs.length %>)</span></h2>
  <p class="muted">Only used if a subscription product is ever sold. The current model is invoice-based (see Invoices).</p>
  <% if (!subs.length) { %><p class="muted">No subscriptions — webhook URL: <code><%= siteUrl %>/webhooks/lemonsqueezy</code></p><% } else { %>
  <div class="scroll"><table class="dense">
    <thead><tr><th>ID</th><th>Customer</th><th>Product</th><th>Status</th><th>Operator</th><th>Renews</th><th></th></tr></thead>
    <tbody>
    <% for (const s of subs) { %>
      <tr>
        <td>#<%= s.subscription_id %></td>
        <td><%= s.user_name %><br><small class="muted"><%= s.user_email %></small><% if (s.company) { %><br><small class="muted"><%= s.company %></small><% } %></td>
        <td><%= s.product_name %><br><small class="muted"><%= s.variant_name %></small></td>
        <td><span class="st st-<%= ['active','on_trial'].includes(s.status) ? 'ok' : (['cancelled','paused','past_due'].includes(s.status) ? 'cancelled' : 'error') %>"><%= s.status_formatted || s.status %></span></td>
        <td>
          <form method="post" action="/admin/billing/operator" class="inlineform">
            <input type="hidden" name="customer_id" value="<%= s.customer_id %>">
            <input name="operator" list="ops" value="<%= s.operator %>" placeholder="Operator" maxlength="100">
            <button>Save</button>
          </form>
        </td>
        <td class="nowrap muted"><%= s.renews_at || '' %><% if (s.ends_at) { %><br>ends <%= s.ends_at %><% } %></td>
        <td class="nowrap"><% if (s.customer_portal_url) { %><a href="<%= s.customer_portal_url %>" target="_blank" rel="noopener">Portal</a><% } %></td>
      </tr>
    <% } %>
    </tbody>
  </table></div>
  <datalist id="ops"><% for (const o of operators) { %><option value="<%= o.operator %>"><% } %></datalist>
  <% } %>
</section>

<section class="card">
  <h2>Recent orders <span class="muted">(<%= orders.length %>)</span></h2>
  <% if (!orders.length) { %><p class="muted">No orders yet</p><% } else { %>
  <div class="scroll"><table class="dense">
    <thead><tr><th>Order</th><th>Date</th><th>Customer</th><th>Product</th><th class="r">Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% for (const o of orders) { %>
      <tr><td>#<%= o.order_number || o.order_id %></td><td class="nowrap muted"><%= o.ordered_at || '' %></td>
        <td><%= o.user_name %> <small class="muted"><%= o.user_email %></small></td>
        <td><%= o.product_name %> <small class="muted"><%= o.variant_name %></small></td>
        <td class="r"><%= fmtMoney(o.total) %> <%= o.currency %><% if (Number(o.refunded_total)) { %><br><small class="muted">refunded <%= fmtMoney(o.refunded_total) %></small><% } %></td>
        <td><span class="st st-<%= o.status === 'paid' ? 'ok' : (o.status === 'pending' ? 'cancelled' : 'error') %>"><%= o.status %></span></td>
        <td><% if (o.receipt_url) { %><a href="<%= o.receipt_url %>" target="_blank" rel="noopener">Receipt</a><% } %></td></tr>
    <% } %>
    </tbody>
  </table></div>
  <% } %>
</section>

<section class="card">
  <h2>Recent webhooks</h2>
  <% if (!events.length) { %><p class="muted">No webhooks received yet</p><% } else { %>
  <table class="dense"><thead><tr><th>Received</th><th>Event</th><th>Type</th><th>ID</th></tr></thead><tbody>
  <% for (const e of events) { %><tr><td class="nowrap muted"><%= e.received_at %></td><td><code><%= e.event_name %></code></td><td><%= e.object_type %></td><td><%= e.object_id %></td></tr><% } %>
  </tbody></table>
  <% } %>
</section>
<%- include('partials/footer') %>
