<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <h1>Payments</h1>
    <p class="subtitle"><%= pay.name %> · payment provider setup and webhook log<%= pay.testMode ? ' · TEST MODE' : '' %></p>
  </div>
  <div class="tools"><a class="btn" href="/admin/invoices">Invoices →</a></div>
</div>

<% if (!lsReady || !webhookReady) { %>
<p class="alert">
  <% if (!lsReady) { %><code><%= pay.envApi %></code> is not set — checkouts cannot be created<br><% } %>
  <% if (!webhookReady) { %><code><%= pay.envSecret %></code> is not set — webhooks will be rejected (503), so subscriptions never activate<% } %>
</p>
<% } %>

<section class="card">
  <h2>Setup</h2>
  <dl class="kv">
    <dt>Provider</dt><dd><b><%= pay.name %></b> (<code>PAYMENT_PROVIDER=<%= pay.key %></code>)<%= pay.testMode ? ' — sandbox' : '' %></dd>
    <dt>Webhook URL</dt><dd><code><%= siteUrl %><%= pay.webhookPath %></code></dd>
    <% if (pay.key === 'polar') { %>
    <dt>Events</dt><dd><code>order.paid</code> <code>order.updated</code> <code>order.refunded</code> <code>subscription.created</code> <code>subscription.active</code> <code>subscription.updated</code> <code>subscription.canceled</code> <code>subscription.uncanceled</code> <code>subscription.revoked</code> · format: Raw</dd>
    <% } else { %>
    <dt>Events</dt><dd><code>order_created</code> <code>order_refunded</code> — subscriptions (plans) require Polar</dd>
    <% } %>
  </dl>
  <% if (pay.key === 'polar') { %>
  <ul class="small muted" style="margin:12px 0 0;padding-left:18px;line-height:1.7">
    <li><b>Plans (monthly/yearly):</b> each paid plan points at a recurring Polar product. Checkout carries <code>subscription_ref</code> in metadata; <code>subscription.*</code> webhooks activate, renew, cancel and expire the plan here. Each renewal's <code>order.paid</code> is recorded as a paid invoice with Polar's receipt.</li>
    <li><b>Invoices (usage over quota, services, custom):</b> fixed ad-hoc THB checkout per invoice; <code>order.paid</code> marks it paid.</li>
  </ul>
  <% } %>
</section>

<section class="card flush">
  <div class="card-head"><h2>Recent webhooks</h2></div>
  <% if (!events.length) { %><div class="empty"><p>No webhooks received yet.</p></div><% } else { %>
  <table><thead><tr><th>Received</th><th>Event</th><th>Object</th></tr></thead><tbody>
  <% for (const e of events) { %><tr><td class="nowrap muted"><%= e.received_at %></td><td><code><%= e.event_name %></code></td><td class="mono small"><%= e.object_id %></td></tr><% } %>
  </tbody></table>
  <% } %>
</section>

<% if (orders.length) { %>
<section class="card flush">
  <div class="card-head"><h2>Lemon Squeezy orders <span class="muted">(legacy)</span></h2></div>
  <div class="scroll"><table>
    <thead><tr><th>Order</th><th>Date</th><th>Customer</th><th>Product</th><th class="r">Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% for (const o of orders) { %>
      <tr><td>#<%= o.order_number || o.order_id %></td><td class="nowrap muted"><%= o.ordered_at || '' %></td>
        <td><%= o.user_name %> <small class="muted"><%= o.user_email %></small></td>
        <td><%= o.product_name %> <small class="muted"><%= o.variant_name %></small></td>
        <td class="r"><%= fmtMoney(o.total) %> <%= o.currency %></td>
        <td><span class="badge b-<%= o.status === 'paid' ? 'paid' : 'void' %>"><%= o.status %></span></td>
        <td><% if (o.receipt_url) { %><a href="<%= o.receipt_url %>" target="_blank" rel="noopener">Receipt</a><% } %></td></tr>
    <% } %>
    </tbody>
  </table></div>
</section>
<% } %>
<%- include('partials/footer') %>
