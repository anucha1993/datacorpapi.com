<%- include('partials/header') %>
<div class="pagehead"><h1>เครื่องที่ใช้งาน <span class="muted">· <%= rows.length %> เครื่อง</span></h1></div>
<section class="card">
  <% if (!rows.length) { %><p class="muted">ยังไม่มีเครื่องใดส่งข้อมูลเข้ามา — ตรวจค่า USAGE_DB_* ใน .env ของโปรแกรม</p><% } else { %>
  <table>
    <thead><tr><th>เครื่อง</th><th>Windows user</th><th>ผู้ใช้งานที่เคยใส่</th><th class="r">ครั้ง</th><th>ครั้งแรก</th><th>ล่าสุด</th><th>รหัสเครื่อง</th></tr></thead>
    <tbody>
    <% for (const r of rows) { %>
      <tr>
        <td><%= r.machine %></td>
        <td><%= r.windows_user %></td>
        <td><%= r.operators %></td>
        <td class="r"><%= fmtNum(r.runs) %></td>
        <td class="muted nowrap"><%= r.first_seen %></td>
        <td class="nowrap"><%= r.last_seen %></td>
        <td class="muted"><code><%= r.install_id %></code></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>
</section>
<%- include('partials/footer') %>
