<%- include('partials/header') %>
<div class="pagehead"><h1>Installs <span class="muted">· <%= rows.length %> machines</span></h1></div>
<section class="card">
  <% if (!rows.length) { %><p class="muted">No machine has reported usage yet — check USAGE_DB_* in the desktop app's .env.</p><% } else { %>
  <table>
    <thead><tr><th>Machine</th><th>Windows user</th><th>Operators used</th><th class="r">Runs</th><th>First seen</th><th>Last seen</th><th>Install ID</th></tr></thead>
    <tbody>
    <% for (const r of rows) { %>
      <tr>
        <td><%= r.machine %></td>
        <td><%= r.windows_user %></td>
        <td><%= r.operators %></td>
        <td class="r"><%= fmtNum(r.runs) %></td>
        <td class="muted nowrap"><%= r.first_seen %></td>
        <td class="nowrap"><%= r.last_seen %></td>
        <td class="muted"><code><%= r.install_id %></code></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>
</section>
<%- include('partials/footer') %>
