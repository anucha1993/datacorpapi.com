<%- include('partials/header') %>
<div class="pagehead"><h1>Services <span class="muted">· <%= rows.length %></span></h1></div>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (error) { %><p class="alert"><%= error %></p><% } %>

<div class="grid2">
  <section class="card">
    <h2><%= editing ? 'Edit service' : 'Add a new service' %></h2>
    <p class="muted small">Services shown here (and marked Active) appear in the customer portal under "Services" — customers can buy them directly and pay via <%= pay.name %>, no need for you to create an invoice by hand.</p>
    <form method="post" action="<%= editing ? '/admin/services/' + editing.id + '/update' : '/admin/services' %>" class="stack">
      <input name="name" placeholder="Service name (shown to customers)" value="<%= editing ? editing.name : '' %>" maxlength="190" required>
      <textarea name="description" placeholder="Short description (optional)" rows="3" maxlength="1000"><%= editing ? editing.description : '' %></textarea>
      <input name="price_thb" type="number" step="0.01" min="<%= MIN_THB %>" placeholder="Price (THB)" value="<%= editing ? editing.price_thb : '' %>" required>
      <div class="actions">
        <button class="primary"><%= editing ? 'Save changes' : 'Add service' %></button>
        <% if (editing) { %><a class="btn" href="/admin/services">Cancel</a><% } %>
      </div>
    </form>
  </section>

  <section class="card">
    <h2>Catalog</h2>
    <% if (!rows.length) { %><p class="muted">No services yet — customers won't see a "Services" tab until you add one.</p><% } else { %>
    <table class="dense">
      <thead><tr><th>Name</th><th class="r">Price (THB)</th><th>Status</th><th></th></tr></thead>
      <tbody>
      <% for (const s of rows) { %>
        <tr>
          <td><%= s.name %><% if (s.description) { %><br><small class="muted"><%= s.description %></small><% } %></td>
          <td class="r strong"><%= fmtMoney(s.price_thb) %></td>
          <td><span class="st st-<%= s.is_active ? 'ok' : 'cancelled' %>"><%= s.is_active ? 'Active' : 'Hidden' %></span></td>
          <td class="nowrap">
            <a class="btn small" href="/admin/services?edit=<%= s.id %>">Edit</a>
            <form method="post" action="/admin/services/<%= s.id %>/toggle" class="inline"><button class="btn small"><%= s.is_active ? 'Hide' : 'Show' %></button></form>
            <form method="post" action="/admin/services/<%= s.id %>/delete" class="inline" onsubmit="return confirm('Delete this service? This does not affect invoices already created from it.')"><button class="link">Delete</button></form>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
    <% } %>
  </section>
</div>
<%- include('partials/footer') %>
