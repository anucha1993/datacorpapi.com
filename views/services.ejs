<%- include('partials/header') %>
<div class="pagehead">
  <div class="titles">
    <h1>Services</h1>
    <p class="subtitle">Sell one-time services. Active services appear in the customer portal under "Buy services".</p>
  </div>
</div>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (error) { %><p class="alert"><%= error %></p><% } %>

<div class="layout-side wider">
  <section class="card flush">
    <div class="card-head"><h2>Catalog <span class="muted">· <%= rows.length %></span></h2></div>
    <% if (!rows.length) { %><div class="empty"><h3>No services yet</h3><p>Add your first service with the form — customers can then order and pay for it themselves.</p></div><% } else { %>
    <div class="scroll"><table>
      <thead><tr><th>Service</th><th class="r">Price (THB)</th><th>Checkout</th><th class="r">Sold</th><th>Status</th><th class="r"></th></tr></thead>
      <tbody>
      <% for (const s of rows) { %>
        <tr class="<%= editing && editing.id === s.id ? 'hl' : '' %>">
          <td><b><%= s.name %></b><% if (s.description) { %><br><small class="muted"><%= s.description.length > 120 ? s.description.slice(0, 120) + '…' : s.description %></small><% } %></td>
          <td class="r strong"><%= fmtMoney(s.price_thb) %></td>
          <td class="small"><% if (s.payment_link) { %><a href="<%= s.payment_link %>" target="_blank" rel="noopener" title="<%= s.payment_link %>">Polar link ↗</a><% } else { %><span class="muted">Auto (API)</span><% } %></td>
          <td class="r"><%= fmtNum(s.sold) %><% if (Number(s.revenue)) { %><br><small class="muted">฿<%= fmtMoney(s.revenue) %></small><% } %></td>
          <td><span class="badge b-<%= s.is_active ? 'active' : 'hidden' %>"><%= s.is_active ? 'Active' : 'Hidden' %></span></td>
          <td class="r nowrap">
            <a class="btn small" href="/admin/services?edit=<%= s.id %>">Edit</a>
            <form method="post" action="/admin/services/<%= s.id %>/toggle" class="inline"><button class="btn small"><%= s.is_active ? 'Hide' : 'Show' %></button></form>
            <form method="post" action="/admin/services/<%= s.id %>/delete" class="inline" onsubmit="return confirm('Delete this service? Invoices already created from it are kept.')"><button class="btn small danger">Delete</button></form>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table></div>
    <% } %>
  </section>

  <section class="card">
    <h2><%= editing ? 'Edit service' : 'Add a service' %></h2>
    <form method="post" action="<%= editing ? '/admin/services/' + editing.id + '/update' : '/admin/services' %>" class="stack">
      <label>Name <span class="hint">Shown to customers</span>
        <input name="name" value="<%= editing ? editing.name : '' %>" maxlength="190" required placeholder="Onboarding &amp; training (2 hours)"></label>
      <label>Description
        <textarea name="description" rows="4" maxlength="1000" placeholder="What's included, delivery time…"><%= editing ? editing.description : '' %></textarea></label>
      <div class="form-grid">
        <label>Price (THB) <input name="price_thb" type="number" step="0.01" min="<%= MIN_THB %>" value="<%= editing ? editing.price_thb : '' %>" required placeholder="1500.00"></label>
        <label>Sort order <span class="hint">Lower first</span><input name="sort_order" type="number" value="<%= editing ? editing.sort_order : 0 %>"></label>
      </div>
      <label>Polar payment link <span class="hint">Optional — paste a Checkout Link from Polar (Products → Checkout Links)</span>
        <input name="payment_link" type="url" value="<%= editing ? editing.payment_link : '' %>" maxlength="700" placeholder="https://buy.polar.sh/polar_cl_…"></label>
      <p class="info small" style="margin:0">
        <b>With a link:</b> customers are sent to that Polar checkout; the price set in Polar must equal the price here. The invoice number is passed as <code>reference_id</code> so the webhook marks it paid.<br>
        <b>Without a link:</b> a fixed-price checkout is created automatically via the <%= pay.name %> API<%= pay.ready ? '' : ' (needs ' + pay.envApi + ')' %>.
      </p>
      <div class="btnrow">
        <button class="primary"><%= editing ? 'Save changes' : 'Add service' %></button>
        <% if (editing) { %><a class="btn" href="/admin/services">Cancel</a><% } %>
      </div>
    </form>
  </section>
</div>
<%- include('partials/footer') %>
