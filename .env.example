# ---- เว็บแอป ----
PORT=3000
# รหัสตั้งค่า (ใช้ครั้งเดียว) สำหรับสร้างบัญชี owner คนแรกที่ /login — สุ่มใหม่เอง 10+ ตัว เช่น  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# หลังสร้างบัญชีแล้ว แอดมินใช้บัญชีในฐานข้อมูล (admin_users) ค่านี้ไม่ถูกใช้อีก
ADMIN_PASSWORD=
# สุ่มข้อความยาว ๆ สำหรับเซ็น cookie session — ห้ามใช้ค่าตัวอย่าง ห้าม commit
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- MySQL (ใช้ user ewp_web จาก sql/usage_schema.sql + sql/billing_schema.sql) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=thaidata_ewp
DB_USER=thaidata_ewp_web
DB_PASSWORD=CHANGE_ME_web_password
# ถ้า MySQL อยู่คนละเครื่องและบังคับ SSL ให้ตั้ง DB_SSL=true
DB_SSL=false

# ---- ข้อมูลธุรกิจที่ต้องแสดงบนเว็บ (ผู้ให้บริการรับชำระเงินตรวจสอบ) ----
# ต้องกรอกให้ครบ — ถ้ายังเป็น CHANGE_ME เว็บจะเตือนตอนเริ่มและที่หน้า admin
PRODUCT_NAME=DataCorp API
COMPANY_NAME=ชื่อผู้ขาย/แบรนด์ หรือชื่อบริษัท (บุคคลธรรมดาใช้ชื่อแบรนด์หรือชื่อตัวเองได้)
COMPANY_NAME_EN=                 # ไม่บังคับ
COMPANY_TAX_ID=                  # ไม่บังคับ (บุคคลธรรมดาเว้นว่าง)
COMPANY_ADDRESS=45/107 Soi 26, Verso Wongwaen-Lam Luk Ka, Bueng Kham Phroi, Lam Luk Ka, Pathum Thani 12150, Thailand
COMPANY_EMAIL=info@datacorpapi.com
COMPANY_PHONE=                      # เว้นว่างได้ถ้าไม่ต้องการแสดงเบอร์โทร
COMPANY_LINE=
SUPPORT_HOURS=Mon–Fri 09:00–18:00 (Bangkok time, UTC+7)
SITE_URL=https://datacorpapi.com
# วันที่นโยบาย/ข้อกำหนดมีผล (แสดงท้ายหน้านโยบาย)
POLICY_EFFECTIVE_DATE=2026-10-21

# ---- ผู้ให้บริการรับชำระเงิน (Merchant of Record) ----
# polar (ค่าเริ่มต้นเมื่อมี POLAR_ACCESS_TOKEN) หรือ lemonsqueezy
PAYMENT_PROVIDER=polar

# ---- Polar (polar.sh) ----
# Settings → API → New token (Organization Access Token) scopes: checkouts:write, products:read, orders:read, orders:write, customers:write
POLAR_ACCESS_TOKEN=
# Settings → Webhooks → Add endpoint: URL = SITE_URL/webhooks/polar, format Raw, events order.paid, order.updated, order.refunded → copy secret
POLAR_WEBHOOK_SECRET=
# Product (one-time) ที่ใช้ออกบิล — เว้นว่างให้ระบบหยิบสินค้าจ่ายครั้งเดียวตัวแรก
POLAR_PRODUCT_ID=
# sandbox = ทดสอบที่ sandbox.polar.sh (token/webhook ของ sandbox แยกจาก production) / production = เก็บเงินจริง
POLAR_SERVER=sandbox

# ---- Lemon Squeezy (ใช้เมื่อ PAYMENT_PROVIDER=lemonsqueezy เท่านั้น) ----
# API key: Settings → API  (ใช้ส่ง usage record ฝั่งเซิร์ฟเวอร์เท่านั้น)
LS_API_KEY=
# Signing secret ที่ตั้งตอนสร้าง Webhook (Settings → Webhooks) URL = SITE_URL/webhooks/lemonsqueezy
LS_WEBHOOK_SECRET=
# ระบบใบแจ้งหนี้: สร้างลิงก์ชำระเงินด้วย API จากสินค้าแบบ Single payment ตัวเดียวในร้าน (ระบบหา Store/Variant ให้เองถ้าเว้นว่าง)
LS_STORE_ID=
LS_VARIANT_ID=
# true = ทดสอบ (ลิงก์เป็น test mode จ่ายด้วยบัตร 4242 4242 4242 4242 ไม่ตัดเงินจริง) / false = เก็บเงินจริง
LS_TEST_MODE=true
# ขั้นต่ำต่อบิล (บาท) ต่ำกว่านี้ยกไปเดือนถัดไป (Lemon Squeezy ขั้นต่ำ ≈ ฿16.83) และจำนวนวันครบกำหนด
INVOICE_MIN_THB=17
INVOICE_DUE_DAYS=15

# ---- AI gateway (/v1/chat/completions แบบเดียวกับ OpenAI) ----
# platform.openai.com → สร้าง Project สำหรับ DataCorp → API keys (ตั้ง monthly budget ที่ Limits ด้วย) — key นี้อยู่บนเซิร์ฟเวอร์เท่านั้น ลูกค้าไม่เห็น
OPENAI_API_KEY=
# อัตราแลกเปลี่ยนที่ใช้คิด credits (1 credit = ฿0.001 ของต้นทุน OpenAI)
AI_USD_THB=36
# slug ของสินค้าที่ใช้ key กับ gateway (ค่าเริ่มต้น ai-api)
AI_PRODUCT_SLUG=ai-api

# ---- รอบบิล ----
# วันตัดรอบของทุกเดือน (1–28): โควตารีเซ็ต + ออกบิลส่วนเกินของรอบที่แล้วอัตโนมัติวันนั้น (ค่าเริ่มต้น 23)
BILLING_CYCLE_DAY=23
# false = ไม่ออกบิลอัตโนมัติ (กด Invoices → Generate เอง)
AUTO_INVOICE=true

# ---- OpenAI key รายลูกค้า (Admin → Customers → OpenAI key) ----
# กุญแจเข้ารหัสค่าในฐานข้อมูล: สุ่ม 64 ตัว — ต้องเป็นค่าเดียวกันทุกเครื่อง/เซิร์ฟเวอร์ที่ใช้ฐานข้อมูลนี้ ห้ามเปลี่ยนภายหลัง (key ที่บันทึกไว้จะอ่านไม่ได้)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# ---- OCR (Google Vision) ผ่าน AI API key: /v1/vision/{images|files}:annotate (แพ็กเกจที่มีโมเดล google-vision-ocr) ----
# Google Cloud → APIs & Services → Credentials → API key (เปิด Cloud Vision API)
GOOGLE_VISION_API_KEY=
